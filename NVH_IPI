def _warn(msg):
    try:
        guitk.BCMessageWindowCreate(guitk.constants.BCMessageBoxWarning,
                                    str(msg), True)
    except Exception:
        print('[WARN] ' + str(msg))


def _info(msg):
    try:
        guitk.BCMessageWindowCreate(guitk.constants.BCMessageBoxInformation,
                                    str(msg), True)
    except Exception:
        print('[INFO] ' + str(msg))


def _clear_selection():
    try:
        fn = getattr(base, 'ClearSelection', None)
        if fn:
            fn()
            return
    except Exception:
        pass


def _pick_grids():
    _clear_selection()
    try:
        base.SetPickMethod(base.constants.ENT_SELECTION)
    except Exception:
        pass
    try:
        nodes = base.PickEntities(constants.NASTRAN, 'GRID')
    except Exception as e:
        print('[DBG] PickEntities failed: {}'.format(e))
        return []
    return list(nodes) if nodes else []


def _collect(etype):
    try:
        return base.CollectEntities(constants.NASTRAN, None, etype)
    except Exception:
        return []


def _get_card_sid(ent, *names):
    if ent is None:
        return None
    names = list(names) if names else ['SID', 'TID', 'ID']
    for fn in names:
        try:
            vals = base.GetEntityCardValues(constants.NASTRAN, ent, (fn,))
        except Exception:
            continue
        if not vals:
            continue
        v = vals.get(fn)
        if v is None or v == '':
            continue
        return getattr(v, '_id', v)
    return getattr(ent, '_id', None)


def _get_entity_name(ent):
    if ent is None:
        return None
    try:
        nm = base.GetEntityName(ent)
        if nm:
            return nm
    except Exception:
        pass
    try:
        nm = base.GetEntityCardValues(
            constants.NASTRAN, ent, ('Name',)).get('Name')
        if nm:
            return nm
    except Exception:
        pass
    return None


def _get_output_keyword():
    kind_w = _STATE.get('out_widget')
    if not kind_w:
        return 'ACCELERATION'
    _, w = kind_w
    try:
        txt = guitk.BCLineEditGetText(w) or ''
    except Exception:
        txt = ''
    low = str(txt).strip().lower()
    if low.startswith('d'):
        return 'DISPLACEMENT'
    if low.startswith('v'):
        return 'VELOCITY'
    return 'ACCELERATION'


def _get_eigr_type():
    """★ 读取用户选择：EIGRL 或 EIGRA"""
    kind_w = _STATE.get('eigr_type_widget')
    if not kind_w:
        return 'EIGRL'
    _, w = kind_w
    try:
        txt = guitk.BCLineEditGetText(w) or ''
    except Exception:
        txt = ''
    return 'EIGRA' if str(txt).strip().upper().startswith('EIGRA') else 'EIGRL'


def _set_entity_name_safe(ent, name):
    for tag, fn in (
        ('base.SetEntityName',
            lambda: base.SetEntityName(ent, name)),
        ('SetEntityCardValues(Name)',
            lambda: base.SetEntityCardValues(
                constants.NASTRAN, ent, {'Name': name})),
        ('SetEntityCardValues(NAME)',
            lambda: base.SetEntityCardValues(
                constants.NASTRAN, ent, {'NAME': name})),
    ):
        try:
            fn()
        except Exception as e:
            print('[DBG] {} failed: {}'.format(tag, e))
            continue
        if _get_entity_name(ent) == name:
            return True
    return False


def _dedupe_state():
    for key in ('dareas', 'rload1s'):
        seen, unique = set(), []
        for item in _STATE[key]:
            nm = item.get('loadset_name')
            if nm is None or nm in seen:
                continue
            seen.add(nm)
            unique.append(item)
        _STATE[key] = unique


