def _find_grid_by_nid(nid):
    for g in _collect('GRID'):
        try:
            v = base.GetEntityCardValues(
                constants.NASTRAN, g, ('NID',)).get('NID')
        except Exception:
            continue
        if v == nid:
            return g
    return None


def _find_set_by_name(name):
    for s in _collect('SET'):
        if _get_entity_name(s) == name:
            return s
    return None


def _collect_used_set_sids():
    used = set()
    for etype in ('SET', 'NSET', 'ESET', 'BSET',
                  'Header Set', 'Element Set', 'Node Set',
                  'NSM Set', 'Group'):
        for s in _collect(etype):
            sid = _get_card_sid(s, 'SID', 'ID')
            if sid is None:
                continue
            try:
                used.add(int(sid))
            except (TypeError, ValueError):
                pass
    return used


def _next_free_set_sid(used):
    n = 1
    while n in used:
        n += 1
    return n


def _ensure_response_set_by_node(node_nid, used_sids):
    """
    ★ 按响应节点整合 SET，名字 = RESP_<nid>。
    X/Y/Z 三个 SUBCASE 共用同一个 SET，不重复建。
    """
    set_name = 'RESP_{}'.format(node_nid)

    existing = _find_set_by_name(set_name)
    if existing is not None:
        sid = _get_card_sid(existing, 'SID', 'ID')
        if sid is not None:
            try:
                used_sids.add(int(sid))
            except (TypeError, ValueError):
                pass
            print('[DBG] SET reused: name={!r}, SID={}, NID={}'
                  .format(set_name, sid, node_nid))
            return sid

    sid = _next_free_set_sid(used_sids)
    used_sids.add(sid)

    set_ent = base.CreateEntity(constants.NASTRAN, 'SET')
    if set_ent is None:
        print('[ERR] SET creation failed for {!r}'.format(set_name))
        return None

    try:
        base.SetEntityCardValues(
            constants.NASTRAN, set_ent, {'SID': sid})
    except Exception as e:
        print('[DBG] SetEntityCardValues SID failed: {}'.format(e))

    if not _set_entity_name_safe(set_ent, set_name):
        print('[ERR] Cannot set name for SET {!r}'.format(set_name))
        try:
            base.DeleteEntity(set_ent)
        except Exception:
            pass
        return None

    grid = _find_grid_by_nid(node_nid)
    if grid is None:
        print('[WARN] GRID NID={} not found; SET will be empty'
              .format(node_nid))
    else:
        added = False
        for call in (
            lambda: base.AddToSet(set_ent, [grid]),
            lambda: base.AddToSet(set_ent, grid),
        ):
            try:
                call()
                added = True
                break
            except Exception as e:
                print('[DBG] AddToSet variant failed: {}'.format(e))
        if not added:
            print('[ERR] AddToSet failed for SET {!r}'.format(set_name))

    actual_sid = _get_card_sid(set_ent, 'SID', 'ID')
    try:
        if actual_sid is not None and int(actual_sid) != int(sid):
            print('[WARN] SET SID mismatch: assigned={}, actual={}'
                  .format(sid, actual_sid))
            sid = actual_sid
    except (TypeError, ValueError):
        pass

    print('[DBG] SET created: name={!r}, SID={}, NID={}'
          .format(set_name, sid, node_nid))
    return sid


# ---------------------------------------------------------------------------
#  NSM 智能处理（导入 BULK，不写 Header）
# ---------------------------------------------------------------------------
def _nsm_get_sid_from_card(ent, field='SID'):
    if ent is None:
        return None
    try:
        vals = base.GetEntityCardValues(constants.NASTRAN, ent, (field,))
    except Exception:
        return None
    v = vals.get(field)
    if v is None or v == '':
        return None
    v = getattr(v, '_id', v)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _nsm_ensure_nsmadd():
    """返回 CEND 中 NSM 关键字使用的 SID（或 None）。NSMADD 通过 BULK 导入。
    ★ NSMADD 是独立实体，不会被 create_header 删除 Header 时误删。"""
    nsm_sids = []
    for ent in _collect('NSM'):
        sid = _nsm_get_sid_from_card(ent, 'SID')
        if sid is not None and sid not in nsm_sids:
            nsm_sids.append(sid)

    nsmadd_sids = []
    for ent in _collect('NSMADD'):
        sid = _nsm_get_sid_from_card(ent, 'SID')
        if sid is not None:
            nsmadd_sids.append(sid)

    if nsmadd_sids:
        return max(nsmadd_sids)

    if not nsm_sids:
        return None

    used = set(nsm_sids) | set(nsmadd_sids)
    new_sid = 1
    while new_sid in used:
        new_sid += 1

    fields = [str(new_sid)] + [str(s) for s in nsm_sids]
    lines = ['BEGIN BULK']
    first = fields[:8]
    lines.append('NSMADD,' + ','.join(first))
    rest = fields[8:]
    while rest:
        chunk = rest[:8]
        lines.append('+,' + ','.join(chunk))
        rest = rest[8:]
    lines.append('ENDDATA')

    if _import_bulk_text('\n'.join(lines) + '\n', 'nsmadd'):
        return new_sid
    return None


