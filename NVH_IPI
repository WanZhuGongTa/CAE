def _create_rload1_for_darea(darea, tabled_ent):
    """
    ★ 'TYPE': '0 Load'  ← ANSA 枚举字符串，导出时自动转 0
    """
    fields = {
        'Name':     darea['loadset_name'],
        'SID':      darea['loadset'],
        'EXCITEID': darea['loadset'],
        'TC':       tabled_ent,
        'TD':       0,
        'TYPE':     '0 Load',
    }
    ent, report = base.CreateEntity(
        constants.NASTRAN, 'RLOAD1', fields,
        debug=constants.REPORT_ALL)
    if ent is None:
        print('[ERR] RLOAD1 failed for {}'.format(darea['loadset_name']))
        for k, v in (report or {}).items():
            print('       {}: {}'.format(k, v))
    else:
        print('[DBG] RLOAD1 created: _id={}, Name={!r}, EXCITEID=LS{}'
              .format(getattr(ent, '_id', None),
                      darea['loadset_name'],
                      darea['loadset_id']))
    return ent


def create_rload1(w, data):
    try:
        _dedupe_state()
        if not _STATE['dareas']:
            _warn('没有可用的 DAREA，请先执行 "1. DAREA Nodes"。')
            return
        if _STATE['tabled_ent'] is None:
            _find_cards_in_model(_get_eigr_type())
        if _STATE['tabled_ent'] is None:
            _warn('模型里没有 TABLED1。请先点 "0. Init Common Cards"。')
            return

        existing = {r['loadset_name'] for r in _STATE['rload1s']}
        pending = [d for d in _STATE['dareas']
                   if not d['has_rload1']
                   and d['loadset_name'] not in existing]
        if not pending:
            _warn('没有新增的 DAREA。')
            return

        count = 0
        for darea in pending:
            rload = _create_rload1_for_darea(darea, _STATE['tabled_ent'])
            if rload is None:
                continue
            darea['has_rload1'] = True
            _STATE['rload1s'].append({
                'entity':       rload,
                'loadset_name': darea['loadset_name'],
                'loadset_id':   darea['loadset_id'],
            })
            count += 1

        _dedupe_state()
        _info('本次共创建 {} 个 RLOAD1。\n当前累计 {} 个 RLOAD1。'
              .format(count, len(_STATE['rload1s'])))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('Create RLOAD 失败：{}'.format(e))


