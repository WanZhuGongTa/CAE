#  [3] Create Header（★ v9-fix-merge-v3：PARAM 直接写进 Header 文本）
# ---------------------------------------------------------------------------
def create_header(w, data):
    """
    ★ v9-fix-merge-v3 修复：
        · PARAM 直接写进 Header 文本（放在 SUBCASE 之后）
        · 移除 _ensure_params_in_bulk() 调用
          —— 因为 ANSA 把 PARAM 归到 Header 里，
             而此函数会删除所有旧 Header，
             导致之前导入的 PARAM 一起被删。
        · NSMADD 保持走 InputNastran（NSMADD 是独立实体，不会丢）
    """
    try:
        _dedupe_state()

        if not _STATE['rload1s']:
            _warn('请先执行 "2. Create RLOAD"。')
            return
        if (_STATE['freq1_sid']   is None or
            _STATE['eigl_sid']    is None or
            _STATE['tabdmp1_tid'] is None):
            _warn('缺少 FREQ1 / TABDMP1 / EIGRL 或 EIGRA。\n'
                  '请先点 "0. Init Common Cards"。')
            return

        # ★ v9-fix-merge-v3：移除 _ensure_params_in_bulk() 调用
        # _ensure_params_in_bulk()

        # NSMADD 走 InputNastran（独立实体，不会被删除 Header 时误删）
        nsm_sid = _nsm_ensure_nsmadd()

        out_kw    = _get_output_keyword()
        eigr_type = _get_eigr_type()
        print('[DBG] 输出类型 = {}, 模态方法 = {}, EIGR SID = {}'
              .format(out_kw, eigr_type, _STATE['eigl_sid']))

        for h in _collect('Nastran Header'):
            try:
                base.DeleteEntity(h)
            except Exception:
                pass
        for s in _collect('SET'):
            nm = _get_entity_name(s)
            if nm and (nm.startswith('PT_') or nm.startswith('RESP_')):
                try:
                    base.DeleteEntity(s)
                except Exception:
                    pass

        # ★ 先按节点建 SET（每个响应节点 1 个）
        name2darea = {d['loadset_name']: d for d in _STATE['dareas']}
        used_sids  = _collect_used_set_sids()

        node_to_set_sid = {}
        for d in _STATE['dareas']:
            nid = d['node_id']
            if nid in node_to_set_sid:
                continue
            sid = _ensure_response_set_by_node(nid, used_sids)
            node_to_set_sid[nid] = sid
        print('[DBG] NID → SET SID：{}'.format(node_to_set_sid))

        # ★ 每个 SUBCASE 通过 NID 反查共用 SET
        rload_set_sids = []
        for rload in _STATE['rload1s']:
            lname = rload['loadset_name']
            darea = name2darea.get(lname)
            if darea is None:
                print('[WARN] No DAREA for loadset_name={!r}'.format(lname))
                rload_set_sids.append(None)
                continue
            rload_set_sids.append(node_to_set_sid.get(darea['node_id']))

        # ===== 只写 CEND 段 + PARAM 追加 =====
        lines = [
            'SOL 111',
            'CEND',
            '$=======================================================================',
            'ECHO = NONE',
            'FREQ = {}'.format(_STATE['freq1_sid']),
        ]
        if nsm_sid is not None:
            lines.append('NSM = {}'.format(nsm_sid))
        lines.append('$')
        lines.append('METHOD(STRUCTURE) = {}'.format(_STATE['eigl_sid']))
        lines.append('SDAMPING(STRUCTURE) = {}'.format(_STATE['tabdmp1_tid']))
        lines.append('$')

        for idx, rload in enumerate(_STATE['rload1s'], start=1):
            set_sid = rload_set_sids[idx - 1]
            lines.append('SUBCASE {}'.format(idx))
            lines.append('LABEL = {}'.format(rload['loadset_name']))
            lines.append('DLOAD = {}'.format(rload['loadset_id']))
            if set_sid is not None:
                lines.append(
                    '{}(SORT2, PUNCH, PHASE) = {}'.format(out_kw, set_sid))
            else:
                print('[WARN] SUBCASE {} (LABEL={}) 缺少有效 SET'
                      .format(idx, rload['loadset_name']))

        # ★ v9-fix-merge-v3：PARAM 直接追加在 Header 文本末尾
        #   （ANSA 导出时会自动把 PARAM 放到 .bdf 的 BULK 段正确位置）
        lines.append('$')
        lines.append('PARAM,POST,-1')
        lines.append('PARAM,AUTOSPC,YES')

        text = '\n'.join(lines)
        print('[DBG] Header:\n{}'.format(text))

        header = base.CreateEntity(constants.NASTRAN, 'Nastran Header')
        if not header:
            _warn('Header 创建失败。')
            return
        base.SetNastranHeaderText(header, text)
        base.SetCurrentEntity(header)

        nsm_msg = 'NSM = {}'.format(nsm_sid) if nsm_sid is not None else '无'
        _info('Header 写入完成（v9-fix-merge-v3）：\n'
              '  SUBCASE 数        = {}\n'
              '  响应 SET 数       = {}（名 RESP_<nid>，X/Y/Z 共享）\n'
              '  模态方法          = {}\n'
              '  EIGR SID          = {}\n'
              '  输出类型          = {}\n'
              '  NSM              = {}\n'
              '  PARAM             = POST=-1, AUTOSPC=YES（写入 Header）'
              .format(len(_STATE['rload1s']),
                      len(node_to_set_sid),
                      eigr_type,
                      _STATE['eigl_sid'],
                      out_kw,
                      nsm_msg))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('Create Header 失败：{}'.format(e))
