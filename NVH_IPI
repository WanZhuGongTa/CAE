def _import_bulk_text(bulk_text, tag='bulk'):
    if not bulk_text or not bulk_text.strip():
        return True
    tmp = os.path.join(tempfile.gettempdir(), '_{}.nas'.format(tag))
    try:
        with open(tmp, 'w') as f:
            f.write(bulk_text)
        r = base.InputNastran(tmp)
        print('[DBG] import {} -> {}'.format(tag, r))
        return True
    except Exception as e:
        print('[ERR] import {} failed: {}'.format(tag, e))
        return False
    finally:
        try:
            os.remove(tmp)
        except Exception:
            pass


