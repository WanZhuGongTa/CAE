def _create_darea(nid, c_str, loadset, darea_name):
    """
    ★ 'C': '1: Fx' / '2: Fy' / '3: Fz'  ← ANSA 枚举字符串，导出时自动转 1/2/3
    """
    fields = {
        'SID':  loadset,
        'by':   'node',
        'P':    nid,
        'C':    c_str,
        'A':    1.0,
        'Name': darea_name,
    }
    ent, report = base.CreateEntity(
        constants.NASTRAN, 'DAREA', fields,
        debug=constants.REPORT_ALL)
    if ent is None:
        print('[ERR] DAREA failed: nid={}, C={!r}'.format(nid, c_str))
        for k, v in (report or {}).items():
            print('       {}: {}'.format(k, v))
    else:
        print('[DBG] DAREA created: _id={}, SID={}, P={}, C={!r}'
              .format(getattr(ent, '_id', None),
                      getattr(loadset, '_id', '?'), nid, c_str))
    return ent


def _create_darea_for_node_dir(nid, c_str, dir_name):
    try:
        loadset_name = 'PT_{}_{}'.format(nid, dir_name)
        if any(d['loadset_name'] == loadset_name for d in _STATE['dareas']):
            return False
        loadset = _create_loadset(loadset_name)
        if loadset is None:
            return False
        darea = _create_darea(nid, c_str, loadset, loadset_name)
        if darea is None:
            return False
        _STATE['dareas'].append({
            'node_id':      nid,
            'loadset_name': loadset_name,
            'loadset_id':   getattr(loadset, '_id', None),
            'loadset':      loadset,
            'darea_entity': darea,
            'c_str':        c_str,
            'dir_name':     dir_name,
            'has_rload1':   False,
        })
        return True
    except Exception as e:
        import traceback
        print('[ERR] _create_darea_for_node_dir exception:')
        print(traceback.format_exc())
        return False


def _print_picked_nodes(nodes):
    out = []
    for node in nodes:
        try:
            nid = base.GetEntityCardValues(
                constants.NASTRAN, node, ('NID',)).get('NID')
        except Exception:
            nid = None
        if nid is not None:
            out.append(nid)
    print('[DBG] picked NIDs ({} 个) = {}'.format(len(out), out))
    return out


def on_darea_nodes(w, data):
    try:
        _cleanup_anonymous_loadsets()
        nodes = _pick_grids()
        if not nodes:
            _warn('未选中任何节点（或点了 Cancel）。')
            return
        nid_list = _print_picked_nodes(nodes)
        processed = {d['node_id'] for d in _STATE['dareas']}
        seen, unique = set(), []
        for nid in nid_list:
            if nid in seen:
                continue
            seen.add(nid)
            unique.append(nid)
        new_nids = [nid for nid in unique if nid not in processed]
        if not new_nids:
            _info('本次拾取的 {} 个节点全部已处理过。'.format(len(nid_list)))
            return

        total = 0
        for nid in new_nids:
            for c_str, dir_name in [('1: Fx', 'Fx'),
                                    ('2: Fy', 'Fy'),
                                    ('3: Fz', 'Fz')]:
                if _create_darea_for_node_dir(nid, c_str, dir_name):
                    total += 1

        _cleanup_anonymous_loadsets()
        _dedupe_state()
        _info('本次共创建 {} 个 DAREA（涉及 {} 个新节点）。\n'
              '当前累计 {} 个 DAREA。'
              .format(total, len(new_nids), len(_STATE['dareas'])))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('DAREA Nodes 失败：{}'.format(e))


