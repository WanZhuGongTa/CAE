def _clear_darea_data(w=None, data=None):
    try:
        names = {d['loadset_name'] for d in _STATE['dareas']}
        if not names:
            _info('当前没有脚本生成的 DAREA，无需清除。')
            return
        ls_ids = set()
        for ls in _collect('LOAD_SET'):
            if _get_entity_name(ls) in names:
                ls_id = getattr(ls, '_id', None)
                if ls_id is not None:
                    ls_ids.add(ls_id)
        n_d = 0
        for darea in _collect('DAREA'):
            try:
                sid_v = base.GetEntityCardValues(
                    constants.NASTRAN, darea, ('SID',)).get('SID')
            except Exception:
                continue
            if getattr(sid_v, '_id', sid_v) in ls_ids:
                try:
                    base.DeleteEntity(darea)
                    n_d += 1
                except Exception:
                    pass
        n_ls = 0
        for ls in _collect('LOAD_SET'):
            if _get_entity_name(ls) in names:
                try:
                    base.DeleteEntity(ls)
                    n_ls += 1
                except Exception:
                    pass
        _STATE['dareas'] = []
        _info('已清除 {} 个 DAREA，{} 个 LOAD_SET。'.format(n_d, n_ls))
    except Exception as e:
        _warn('清除 DAREA 失败：{}'.format(e))


def _clear_rload_data(w=None, data=None):
    try:
        names = {r['loadset_name'] for r in _STATE['rload1s']}
        n = 0
        for rload in _collect('RLOAD1'):
            if _get_entity_name(rload) in names:
                try:
                    base.DeleteEntity(rload)
                    n += 1
                except Exception:
                    pass
        for d in _STATE['dareas']:
            d['has_rload1'] = False
        _STATE['rload1s'] = []
        _info('已清除 {} 个 RLOAD1。'.format(n))
    except Exception as e:
        _warn('清除 RLOAD 失败：{}'.format(e))


def _clear_header_data(w=None, data=None):
    try:
        n_h = 0
        for h in _collect('Nastran Header'):
            try:
                base.DeleteEntity(h)
                n_h += 1
            except Exception:
                pass
        n_s = 0
        for s in _collect('SET'):
            nm = _get_entity_name(s)
            if nm and (nm.startswith('PT_') or nm.startswith('RESP_')):
                try:
                    base.DeleteEntity(s)
                    n_s += 1
                except Exception:
                    pass
        _info('已清除 {} 个 Header，{} 个响应 SET。'.format(n_h, n_s))
    except Exception as e:
        _warn('清除 Header 失败：{}'.format(e))


def _clear_all_data(w=None, data=None):
    try:
        _clear_header_data(w, data)
        _clear_rload_data(w, data)
        _clear_darea_data(w, data)
        _info('已清除所有脚本生成的数据。')
    except Exception as e:
        _warn('Clear All 失败：{}'.format(e))


