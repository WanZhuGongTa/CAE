        print(traceback.format_exc())
        _warn('清除 RLOAD 数据失败：{}'.format(e))


def _clear_response_data(w=None, data=None):
    try:
        print('[DBG] === Clear Response SET ===')
        n = 0
        
        # ★ 修复：优先删除内存状态中直接记录的 SET 实体
        if _STATE.get('response_set') is not None:
            try:
                base.DeleteEntity(_STATE['response_set'])
