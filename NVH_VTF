def _find_grid_by_nid(nid):
    for g in _collect('GRID'):
        try:
            v = base.GetEntityCardValues(
                constants.NASTRAN, g, ('NID',)).get('NID')
        except Exception:
            continue
        if v == nid:
            return g
    return None


def _find_set_by_name(name):
    for s in _collect('SET'):
        if _get_entity_name(s) == name:
            return s
    return None


def _collect_used_set_sids():
    used = set()
    for etype in ('SET',
                  'NSET', 'ESET', 'BSET',
                  'Header Set', 'Element Set', 'Node Set',
                  'NSM Set', 'Group'):
        for s in _collect(etype):
            sid = _get_card_sid(s, 'SID', 'ID')
            if sid is None:
                continue
            try:
                used.add(int(sid))
            except (TypeError, ValueError):
                pass
    return used


def _next_free_set_sid(used):
    n = 1
    while n in used:
        n += 1
    return n


def _delete_response_set():
    if _STATE['response_set'] is not None:
        try:
            base.DeleteEntity(_STATE['response_set'])
            print('[DBG] removed old response SET (from state)')
        except Exception as e:
            print('[DBG] delete old response SET failed: {}'.format(e))
        _STATE['response_set'] = None
        _STATE['response_sid'] = None

    for _ in range(5):
        old = _find_set_by_name(RESPONSE_SET_NAME)
        if old is None:
            break
        try:
            base.DeleteEntity(old)
            print('[DBG] removed residual {} SET'.format(RESPONSE_SET_NAME))
        except Exception as e:
            print('[DBG] delete residual SET failed: {}'.format(e))
            break


def _rebuild_response_set():
    """全量重建 NTF_RESPONSE SET。"""
    _delete_response_set()

    if not _STATE['response_nids']:
        print('[DBG] no response nodes → SET not created')
        return

    used = _collect_used_set_sids()
    sid  = _next_free_set_sid(used)
    print('[DBG] 分配 {} SID = {}'.format(RESPONSE_SET_NAME, sid))

    set_ent = base.CreateEntity(constants.NASTRAN, 'SET')
    if set_ent is None:
        print('[ERR] SET creation failed')
        return

    try:
        base.SetEntityCardValues(
            constants.NASTRAN, set_ent, {'SID': sid})
    except Exception as e:
        print('[DBG] SetEntityCardValues SID failed: {}'.format(e))

    if not _set_entity_name_safe(set_ent, RESPONSE_SET_NAME):
        print('[WARN] Cannot set name for SET {!r}, will still keep it'
              .format(RESPONSE_SET_NAME))

    # ★ 修复优化：建立 NID -> GRID 映射，避免循环调用 _find_grid_by_nid 导致卡顿
    all_grids = _collect('GRID')
    grid_map = {}
    for g in all_grids:
        try:
            nid = base.GetEntityCardValues(constants.NASTRAN, g, ('NID',)).get('NID')
            if nid is not None:
                grid_map[nid] = g
        except Exception:
            pass

    grids = []
    for nid in sorted(_STATE['response_nids']):
        g = grid_map.get(nid)
        if g is not None:
            grids.append(g)
        else:
            print('[WARN] Response GRID NID={} not found'.format(nid))

    if grids:
        added_count = 0
        # ★ 修复：逐个加入，解决 ANSA 某些版本 AddToSet 传列表失败只加第一个的问题
        for g in grids:
            try:
                base.AddToSet(set_ent, g)
                added_count += 1
            except Exception as e:
                print('[DBG] AddToSet failed for grid NID={}: {}'.format(
                    base.GetEntityCardValues(constants.NASTRAN, g, ('NID',)).get('NID', '?'), e))

        if added_count == 0:
            print('[ERR] AddToSet failed for all grids in {}'.format(RESPONSE_SET_NAME))
        else:
            print('[DBG] Successfully added {} grids to SET'.format(added_count))

    actual = _get_card_sid(set_ent, 'SID', 'ID')
    try:
        if actual is not None and int(actual) != int(sid):
            print('[WARN] SET SID mismatch: assigned={}, actual={}'
                  .format(sid, actual))
            sid = actual
    except (TypeError, ValueError):
        pass

    _STATE['response_set'] = set_ent
    _STATE['response_sid'] = sid
    print('[DBG] {} SET created: SID={}, {} nodes'
          .format(RESPONSE_SET_NAME, sid, len(grids)))


# ---------------------------------------------------------------------------
#  [3] Response Nodes —— 声腔响应点
# ---------------------------------------------------------------------------
def on_response_nodes(w, data):
    """[3] 左键：拾取声腔节点 → 累积到 NTF_RESPONSE SET。
    set 天然去重。"""
    try:
        print('[DBG] ============================================')
        print('[DBG] NTF Response Nodes (Cavity) clicked')

        nodes = _pick_grids()
        print('[DBG] picked GRID count = {}'.format(len(nodes)))
        if not nodes:
            _warn('未选中任何节点。')
            return

        nid_list = _print_picked_nodes(nodes)

        added = 0
        non_fluid = 0
        for nid in nid_list:
            try:
                node = _find_grid_by_nid(nid)
                if node is not None:
                    cd = base.GetEntityCardValues(
                        constants.NASTRAN, node, ('CD',)).get('CD')
                    if cd is not None and int(cd) != -1:
                        non_fluid += 1
            except Exception:
                pass
            if nid not in _STATE['response_nids']:
                _STATE['response_nids'].add(nid)
                added += 1

        if non_fluid > 0:
            print('[WARN] 有 {} 个响应点 CD != -1，可能不是流体声腔节点'
                  .format(non_fluid))

        print('[DBG] 本次新增 {} 个响应点，累计 {}'.format(
            added, len(_STATE['response_nids'])))

        _rebuild_response_set()

        _info('本次拾取 {} 个节点，其中 {} 个为新增声腔响应点。\n'
              '当前累计 {} 个响应点，NTF_RESPONSE SET SID = {}。'
              .format(len(nid_list), added,
                      len(_STATE['response_nids']),
                      _STATE['response_sid']))
    except Exception as e:
        import traceback
        print('[ERR] on_response_nodes exception:')
        print(traceback.format_exc())
        _warn('Response Nodes 操作失败：{}'.format(e))


# ---------------------------------------------------------------------------
#  [4] Create Header（★ v4-fix-merge-v2：PARAM + ACMODL 直接写进 Header 文本）
# ---------------------------------------------------------------------------
def create_header(w, data):
    """[4] 写 SOL 111 NTF Header（只写 CEND 段 + PARAM/ACMODL 追加）。

    ★ v4-fix-merge-v2 修复：
        · PARAM + ACMODL 直接写进 Header 文本（放在 SUBCASE 之后）
        · 移除 _ensure_params_in_bulk() 调用
          —— 因为 ANSA 把 PARAM/ACMODL 归到 Header 里，
             而此函数会删除所有旧 Header，
             导致之前导入的卡片一起被删。
        · NSMADD 保持走 InputNastran（NSMADD 是独立实体，不会丢）
    """
    try:
        _dedupe_state()

        if not _STATE['rload1s']:
            _warn('请先执行 "2. Create RLOAD"。')
            return
        if (_STATE['freq1_sid']          is None or
            _STATE['eigl_struct_sid']    is None or
            _STATE['eigl_fluid_sid']     is None or
            _STATE['tabdmp1_struct_tid'] is None or
            _STATE['tabdmp1_fluid_tid']  is None):
            _warn('模型里缺少 FREQ1 / TABDMP1 / EIGRL（结构或流体）。\n'
                  '请先点 "0. Init Common Cards"。')
            return
        if not _STATE['response_nids']:
            _warn('没有响应点，请先执行 "3. Response Nodes"。')
            return

        _rebuild_response_set()

        resp_sid = _STATE['response_sid']
        if resp_sid is None:
            _warn('NTF_RESPONSE SET 未建立，无法写 Header。')
            return

        out_kw = _get_output_keyword()
        print('[DBG] 输出类型关键字（完整）：{}'.format(out_kw))
        print('[DBG] 响应 SET SID = {}, 响应点数 = {}'
              .format(resp_sid, len(_STATE['response_nids'])))

        # ★ v4-fix-merge-v2：移除 _ensure_params_in_bulk() 调用
        # _ensure_params_in_bulk()

        # NSMADD 走 InputNastran（独立实体，不会被删除 Header 时误删）
        nsm_sid = _nsm_ensure_nsmadd()
        print('[DBG] NSM SID（用于 CEND）= {}'.format(nsm_sid))

        headers = _collect('Nastran Header')
        print('[DBG] 发现已有 Header 数量：{}'.format(len(headers)))
        for h in headers:
            try:
                base.DeleteEntity(h)
                print('[DBG]   removed Header: _id={}'
                      .format(getattr(h, '_id', '?')))
            except Exception as e:
                print('[DBG]   delete Header failed: {}'.format(e))

        header = base.CreateEntity(constants.NASTRAN, 'Nastran Header')
        if not header:
            _warn('Header 创建失败。')
            return

        # ---- ★ 只写 CEND 段 + PARAM/ACMODL 追加 ----
        lines = [
            'SOL 111',
            'CEND',
            '$=======================================================================',
            'ECHO = NONE',
            'FREQ = {}'.format(_STATE['freq1_sid']),
        ]
        if nsm_sid is not None:
            lines.append('NSM = {}'.format(nsm_sid))
        lines.append('$')
        lines.append('METHOD(STRUCTURE) = {}'.format(_STATE['eigl_struct_sid']))
        lines.append('METHOD(FLUID)     = {}'.format(_STATE['eigl_fluid_sid']))
        lines.append('SDAMPING(STRUCTURE) = {}'.format(_STATE['tabdmp1_struct_tid']))
        lines.append('SDAMPING(FLUID)     = {}'.format(_STATE['tabdmp1_fluid_tid']))
        lines.append('$')

        for idx, rload in enumerate(_STATE['rload1s'], start=1):
            lines.append('SUBCASE {}'.format(idx))
            lines.append('LABEL = {}'.format(rload['loadset_name']))
            lines.append('DLOAD = {}'.format(rload['loadset_id']))
            lines.append(
                '{}(SORT2, PUNCH, PHASE) = {}'.format(out_kw, resp_sid))

        # ★ v4-fix-merge-v2：PARAM + ACMODL 直接追加在 Header 文本末尾
        #   （ANSA 导出时会自动把 PARAM/ACMODL 放到 .bdf 的 BULK 段正确位置）
        lines.append('$')
        lines.append('PARAM,DBALL,SCRATCH')
        lines.append('PARAM,COUPMASS,1')
        lines.append('PARAM,TINY,0.')
        lines.append('PARAM,EST,-1')
        lines.append('PARAM,MAXRATIO,5.E8')
        lines.append('PARAM,EPPRT,5.E-8')
        lines.append('PARAM,GRDPNT,0')
        lines.append('PARAM,K6ROT,100.0')
        lines.append('PARAM,SNORM,20.0')
        lines.append('PARAM,AUTOSPC,YES')
        lines.append('PARAM,SKINOUT,PUNCH')
        lines.append('ACMODL,DIFF')

        text = '\n'.join(lines)
        print('[DBG] Header（只写 CEND + PARAM/ACMODL）:\n{}'.format(text))

        base.SetNastranHeaderText(header, text)
        base.SetCurrentEntity(header)

        nsm_msg = ('NSM = {}'.format(nsm_sid)
                   if nsm_sid is not None else '无')

        _info('NTF Header 写入完成（v4-fix-merge-v2）：\n'
              '  SUBCASE 数        = {}\n'
              '  响应 SET SID      = {}（{} 个声腔点，共享）\n'
              '  输出类型          = {}\n'
              '  METHOD(STRUCTURE) = {}\n'
              '  METHOD(FLUID)     = {}\n'
              '  SDAMPING(STRUCT)  = {}\n'
              '  SDAMPING(FLUID)   = {}\n'
              '  FREQ              = {}\n'
              '  {}\n'
              '  PARAM             = DBALL / COUPMASS / TINY / EST / MAXRATIO / EPPRT / GRDPNT / K6ROT / SNORM / AUTOSPC / SKINOUT（写入 Header）\n'
              '  ACMODL            = DIFF（写入 Header）'
              .format(len(_STATE['rload1s']),
                      resp_sid,
                      len(_STATE['response_nids']),
                      out_kw,
                      _STATE['eigl_struct_sid'],
                      _STATE['eigl_fluid_sid'],
                      _STATE['tabdmp1_struct_tid'],
                      _STATE['tabdmp1_fluid_tid'],
                      _STATE['freq1_sid'],
                      nsm_msg))
    except Exception as e:
        import traceback
        print('[ERR] create_header exception:')
        print(traceback.format_exc())
        _warn('Create Header 失败：{}'.format(e))
