def _create_darea(nid, c_str, loadset, darea_name):
    fields = {
        'SID':  loadset,
        'by':   'node',
        'P':    nid,
        'C':    c_str,
        'A':    1.0,
        'Name': darea_name,
    }
    ent, report = base.CreateEntity(
        constants.NASTRAN, 'DAREA', fields,
        debug=constants.REPORT_ALL
    )
    if ent is None:
        print('[ERR] DAREA failed:')
        for k, v in (report or {}).items():
            print('       {}: {}'.format(k, v))
        return None
    print('[DBG] DAREA created: _id={}, SID={}, P={}, C={!r}'
          .format(getattr(ent, '_id', None), loadset._id, nid, c_str))
    return ent


def _create_darea_for_node_dir(nid, c_str, dir_name):
    """同名 loadset 已存在则跳过。"""
    try:
        loadset_name = 'PT_{}_{}'.format(nid, dir_name)
        if any(d['loadset_name'] == loadset_name
               for d in _STATE['dareas']):
            print('[DBG] Skip duplicate loadset: {}'.format(loadset_name))
            return False

        loadset = _create_loadset(loadset_name)
        if loadset is None:
            return False
        darea = _create_darea(nid, c_str, loadset, loadset_name)
        if darea is None:
            return False
        _STATE['dareas'].append({
            'node_id':      nid,
            'loadset_name': loadset_name,
            'loadset_id':   getattr(loadset, '_id', None),
            'loadset':      loadset,
            'darea_entity': darea,
            'c_str':        c_str,
            'dir_name':     dir_name,
            'has_rload1':   False,
        })
        return True
    except Exception as e:
        import traceback
        print('[ERR] _create_darea_for_node_dir exception:')
        print(traceback.format_exc())
        return False


def _print_picked_nodes(nodes):
    nid_list = []
    for node in nodes:
        try:
            nid = base.GetEntityCardValues(
                constants.NASTRAN, node, ('NID',)).get('NID')
        except Exception:
            nid = None
        if nid is not None:
            nid_list.append(nid)
    print('[DBG] picked NIDs ({} 个) = {}'.format(len(nid_list), nid_list))
    return nid_list


def on_darea_nodes(w, data):
    """[1] 左键：拾取激励点 → 每节点建 Fx/Fy/Fz 三个 DAREA。
    拾取后剔除已处理的 NID。"""
    try:
        print('[DBG] ============================================')
        print('[DBG] NTF DAREA Nodes (Excitation) clicked')
        _cleanup_anonymous_loadsets()

        nodes = _pick_grids()
        print('[DBG] picked GRID count = {}'.format(len(nodes)))
        if not nodes:
            _warn('未选中任何节点（或点了 Cancel）。')
            return

        nid_list = _print_picked_nodes(nodes)

        processed_nids = {d['node_id'] for d in _STATE['dareas']}
        seen_this_pick = set()
        unique_picked = []
        for nid in nid_list:
            if nid in seen_this_pick:
                continue
            seen_this_pick.add(nid)
            unique_picked.append(nid)

        new_nids = [nid for nid in unique_picked
                    if nid not in processed_nids]
        skipped_processed = len(unique_picked) - len(new_nids)
        skipped_internal = len(nid_list) - len(unique_picked)

        print('[DBG] 拾取 {} 个 → 本次去重 {} 个 → 已处理剔除 {} 个 '
              '→ 待处理 {} 个'
              .format(len(nid_list), skipped_internal,
                      skipped_processed, len(new_nids)))

        if not new_nids:
            _info('本次拾取的 {} 个激励点全部已处理过，无需重复创建。\n'
                  '（如需重新处理，请点 "清除 1" 或 "5. Clear All"）'
                  .format(len(nid_list)))
            return

        preview = ', '.join(str(n) for n in new_nids[:30])
        if len(new_nids) > 30:
            preview += ' ...'
        skipped_msg = ''
        if skipped_processed > 0 or skipped_internal > 0:
            skipped_msg = ('\n（自动跳过 {} 个重复/已处理节点）'
                           .format(skipped_processed + skipped_internal))
        _info('本次拾取 {} 个节点，其中 {} 个为新节点：\n{}{}'
              .format(len(nid_list), len(new_nids), preview, skipped_msg))

        total = 0
        for nid in new_nids:
            for c_str, dir_name in [('1: Fx', 'Fx'),
                                    ('2: Fy', 'Fy'),
                                    ('3: Fz', 'Fz')]:
                if _create_darea_for_node_dir(nid, c_str, dir_name):
                    total += 1

        print('[DBG] --- 创建后清理 ghost Load Set ---')
        _cleanup_anonymous_loadsets()
        _dedupe_state()

        _info('本次共创建 {} 个 DAREA（涉及 {} 个新激励点）。\n'
              '当前累计 {} 个 DAREA（激励）。'
              .format(total, len(new_nids), len(_STATE['dareas'])))
    except Exception as e:
        import traceback
        print('[ERR] on_darea_nodes exception:')
        print(traceback.format_exc())
        _warn('DAREA Nodes 操作失败：{}'.format(e))


