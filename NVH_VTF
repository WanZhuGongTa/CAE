def _create_loadset(name):
    try:
        ls = base.CreateEntity(constants.NASTRAN, 'LOAD_SET', {'Name': name})
        if ls is not None:
            print('[DBG] LOAD_SET created: _id={}, name={}'
                  .format(getattr(ls, '_id', None), name))
            return ls
    except Exception as e:
        print('[DBG] one-step LOAD_SET failed: {}'.format(e))

    ls = base.CreateEntity(constants.NASTRAN, 'LOAD_SET')
    if ls is None:
        return None
    try:
        base.SetEntityName(ls, name)
    except Exception:
        try:
            base.SetEntityCardValues(
                constants.NASTRAN, ls, {'Name': name})
        except Exception:
            pass
    return ls


def _is_anonymous(nm):
    if nm is None:
        return True
    if nm == '' or nm == 0 or nm == '0':
        return True
    s = str(nm).strip()
    if s == '':
        return True
    low = s.lower()
    return 'anonymous' in low or 'unnamed' in low


def _delete_bc_referencing(loadset_id):
    for bc_type in ['DAREA', 'RLOAD1', 'RLOAD2', 'SPC', 'MPC',
                    'LOAD', 'DLOAD', 'FORCE', 'MOMENT']:
        for bc in _collect(bc_type):
            try:
                sid_v = base.GetEntityCardValues(
                    constants.NASTRAN, bc, ('SID',)).get('SID')
            except Exception:
                continue
            ref_id = getattr(sid_v, '_id', sid_v)
            if ref_id == loadset_id:
                try:
                    base.DeleteEntity(bc)
                except Exception:
                    pass


def _cleanup_anonymous_loadsets():
    to_delete = []
    for ls in _collect('LOAD_SET'):
        ls_id = getattr(ls, '_id', '?')
        nm = None
        try:
            nm = base.GetEntityName(ls)
        except Exception:
            pass
        if not nm:
            try:
                nm = base.GetEntityCardValues(
                    constants.NASTRAN, ls, ('Name',)).get('Name')
            except Exception:
                pass
        if _is_anonymous(nm):
            to_delete.append((ls, ls_id))
    for ls, ls_id in to_delete:
        _delete_bc_referencing(ls_id)
        try:
            base.DeleteEntity(ls)
        except Exception:
            pass


