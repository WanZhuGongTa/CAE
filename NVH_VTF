        tabled_sid, tabdmp_sid, freq_sid, eigl_sid = _allocate_common_sids()
        print('[DBG] 分配 SID：TABLED1={}, TABDMP1={}, FREQ1={}, EIGRL={}'
              .format(tabled_sid, tabdmp_sid, freq_sid, eigl_sid))

        nas_text = _build_common_cards_nas(
