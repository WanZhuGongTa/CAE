def _clear_darea_data(w=None, data=None):
    try:
        print('[DBG] === Clear DAREA data ===')
        script_ls_names = {d['loadset_name'] for d in _STATE['dareas']}
        if not script_ls_names:
            _info('当前没有脚本生成的 DAREA 记录，无需清除。')
            return

        loadset_ids = set()
        for ls in _collect('LOAD_SET'):
            nm = _get_entity_name(ls)
            if nm in script_ls_names:
                ls_id = getattr(ls, '_id', None)
                if ls_id is not None:
                    loadset_ids.add(ls_id)

        n_darea = 0
        for darea in _collect('DAREA'):
            try:
                sid_v = base.GetEntityCardValues(
                    constants.NASTRAN, darea, ('SID',)).get('SID')
            except Exception:
                continue
            ref_id = getattr(sid_v, '_id', sid_v)
            if ref_id in loadset_ids:
                try:
                    base.DeleteEntity(darea)
                    n_darea += 1
                except Exception as e:
                    print('[DBG] delete DAREA failed: {}'.format(e))

        n_ls = 0
        for ls in _collect('LOAD_SET'):
            nm = _get_entity_name(ls)
            if nm in script_ls_names:
                try:
                    base.DeleteEntity(ls)
                    n_ls += 1
                except Exception as e:
                    print('[DBG] delete LOAD_SET failed: {}'.format(e))

        _STATE['dareas'] = []
        print('[DBG] Cleared {} DAREA, {} LOAD_SET'.format(n_darea, n_ls))
        _info('已清除 {} 个 DAREA，{} 个 LOAD_SET。'.format(n_darea, n_ls))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('清除 DAREA 数据失败：{}'.format(e))


def _clear_rload_data(w=None, data=None):
