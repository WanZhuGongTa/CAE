def _pad8(s):
    return '{:<8}'.format(str(s))[:8]


def _collect_used_sids(etype_list):
    used = set()
    for etype in etype_list:
        for ent in _collect(etype):
            sid = _get_card_sid(ent)
            if sid is None:
                continue
            try:
                used.add(int(sid))
            except (TypeError, ValueError):
                pass
    return used


def _next_free_sid(etype_list):
    used = _collect_used_sids(etype_list)
    n = 1
    while n in used:
        n += 1
    return n


def _allocate_ntf_sids():
    """按类型独立分配 SID：
       TABLED1 / TABDMP1(结构) / TABDMP1(流体) / FREQ1 / EIGRL(结构) / EIGRL(流体)
    """
    tabled_sid = _next_free_sid(['TABLED1', 'TABLED'])

    used_tabdmp = _collect_used_sids(['TABDMP1', 'TABDMP', 'TABDMP0'])
    tabdmp_struct = 1
    while tabdmp_struct in used_tabdmp:
        tabdmp_struct += 1
    used_tabdmp.add(tabdmp_struct)
    tabdmp_fluid = 1
    while tabdmp_fluid in used_tabdmp:
        tabdmp_fluid += 1

    freq_sid = _next_free_sid(['FREQ1', 'FREQ'])

    used_eigl = _collect_used_sids(['EIGRL', 'EIGR'])
    eigl_struct = 1
    while eigl_struct in used_eigl:
        eigl_struct += 1
    used_eigl.add(eigl_struct)
    eigl_fluid = 1
    while eigl_fluid in used_eigl:
        eigl_fluid += 1

    return {
        'tabled':        tabled_sid,
        'tabdmp_struct': tabdmp_struct,
        'tabdmp_fluid':  tabdmp_fluid,
        'freq':          freq_sid,
        'eigl_struct':   eigl_struct,
        'eigl_fluid':    eigl_fluid,
    }


def _build_common_cards_nas(alloc, f1, df, ndf,
                            damp_struct, v2_struct,
                            damp_fluid, v2_fluid,
                            tx1, ty1, tx2, ty2):
    lines = []
    lines.append('BEGIN BULK')

    lines.append(_pad8('TABLED1') + _pad8(str(alloc['tabled'])) +
                 _pad8('LINEAR') + _pad8('LINEAR'))
    lines.append('+' + ' ' * 7 +
                 _pad8(tx1) + _pad8(ty1) +
                 _pad8(tx2) + _pad8(ty2))
    lines.append('+' + ' ' * 7 + _pad8('ENDT'))

    lines.append(_pad8('TABDMP1') + _pad8(str(alloc['tabdmp_struct'])) + _pad8('G'))
    lines.append('+' + ' ' * 7 +
                 _pad8(tx1) + _pad8(damp_struct) +
                 _pad8(tx2) + _pad8(damp_struct))
    lines.append('+' + ' ' * 7 + _pad8('ENDT'))

    lines.append(_pad8('TABDMP1') + _pad8(str(alloc['tabdmp_fluid'])) + _pad8('G'))
    lines.append('+' + ' ' * 7 +
                 _pad8(tx1) + _pad8(damp_fluid) +
                 _pad8(tx2) + _pad8(damp_fluid))
    lines.append('+' + ' ' * 7 + _pad8('ENDT'))

    lines.append('FREQ1,{},{},{},{}'.format(
        alloc['freq'], f1, df, ndf))
    lines.append('EIGRL,{},0.0,{}'.format(
        alloc['eigl_struct'], v2_struct))
    lines.append('EIGRL,{},0.0,{}'.format(
        alloc['eigl_fluid'], v2_fluid))
    lines.append('ENDDATA')
    return '\n'.join(lines) + '\n'


def _find_cards_in_model(allocated=None):
    tabs = _collect('TABLED1') or _collect('TABLED')
    if tabs:
        _STATE['tabled_ent'] = tabs[0]
        print('[DBG] Found TABLED1: SID/TID={}'
              .format(_get_card_sid(tabs[0], 'TID', 'SID', 'ID')))

    if allocated:
        _STATE['tabdmp1_struct_tid'] = allocated['tabdmp_struct']
        _STATE['tabdmp1_fluid_tid']  = allocated['tabdmp_fluid']
        _STATE['freq1_sid']          = allocated['freq']
        _STATE['eigl_struct_sid']    = allocated['eigl_struct']
        _STATE['eigl_fluid_sid']     = allocated['eigl_fluid']
        print('[DBG] 卡片 SID（按分配记录）：TABDMP1(S)={}, TABDMP1(F)={}, '
              'FREQ1={}, EIGRL(S)={}, EIGRL(F)={}'
              .format(allocated['tabdmp_struct'], allocated['tabdmp_fluid'],
                      allocated['freq'],
                      allocated['eigl_struct'], allocated['eigl_fluid']))
    else:
        tabdmps = _collect('TABDMP1') + _collect('TABDMP')
        if len(tabdmps) >= 1:
            _STATE['tabdmp1_struct_tid'] = _get_card_sid(
                tabdmps[0], 'TID', 'SID', 'ID')
        if len(tabdmps) >= 2:
            _STATE['tabdmp1_fluid_tid'] = _get_card_sid(
                tabdmps[1], 'TID', 'SID', 'ID')

        for name in ('FREQ1', 'FREQ'):
            ents = _collect(name)
            if ents:
                _STATE['freq1_sid'] = _get_card_sid(ents[0], 'SID', 'TID', 'ID')
                break

        eigrls = _collect('EIGRL') + _collect('EIGR')
        if len(eigrls) >= 1:
            _STATE['eigl_struct_sid'] = _get_card_sid(
                eigrls[0], 'SID', 'TID', 'ID')
        if len(eigrls) >= 2:
            _STATE['eigl_fluid_sid'] = _get_card_sid(
                eigrls[1], 'SID', 'TID', 'ID')


def init_common_cards(w, data):
    try:
        print('[DBG] ============================================')
        print('[DBG] NTF Init Common Cards clicked')

        model_dareas = _collect('DAREA')
        if not model_dareas and _STATE['dareas']:
            print('[DBG] 模型里无 DAREA 但缓存有 {} 条记录，'
                  '判定为新模型，清空缓存'.format(len(_STATE['dareas'])))
            _STATE['dareas'] = []
            _STATE['rload1s'] = []

        freq_edit, ds_edit, es_edit, df_edit, ef_edit, tab_edit = data

        text_freq = guitk.BCLineEditGetText(freq_edit)
        parts = [p.strip() for p in text_freq.split(',')]
        if len(parts) != 3:
            _warn('FREQ1 格式应为 "F1, DF, NDF"')
            return
        f1, df, ndf = float(parts[0]), float(parts[1]), int(float(parts[2]))

        damp_struct = guitk.BCLineEditGetDouble(ds_edit)
        if damp_struct <= 0:
            _warn('结构阻尼比必须大于 0')
            return

        v2_struct = guitk.BCLineEditGetDouble(es_edit)
        if v2_struct <= 0:
            _warn('结构 EIGRL 上限频率必须大于 0')
            return

        damp_fluid = guitk.BCLineEditGetDouble(df_edit)
        if damp_fluid <= 0:
            _warn('流体阻尼比必须大于 0')
            return

        v2_fluid = guitk.BCLineEditGetDouble(ef_edit)
        if v2_fluid <= 0:
            _warn('流体 EIGRL 上限频率必须大于 0')
            return

        text_tab = guitk.BCLineEditGetText(tab_edit)
        parts_t = [p.strip() for p in text_tab.split(',')]
        if len(parts_t) != 4:
            _warn('TABLED1 格式应为 "x1, y1, x2, y2"')
            return
        tx1, ty1, tx2, ty2 = [float(p) for p in parts_t]

        print('[DBG] 参数：FREQ1=({},{},{}), damp_struct={}, V2_struct={}, '
              'damp_fluid={}, V2_fluid={}, TABLED=({},{},{},{})'
              .format(f1, df, ndf, damp_struct, v2_struct,
                      damp_fluid, v2_fluid, tx1, ty1, tx2, ty2))
        print('[DBG] 当前输出类型：{}'.format(_get_output_keyword()))

        for etype in ('TABLED1', 'TABLED',
                      'TABDMP', 'TABDMP1',
                      'FREQ', 'FREQ1',
                      'EIGRL', 'EIGR'):
            for ent in _collect(etype):
                try:
                    base.DeleteEntity(ent)
                    print('[DBG] Deleted existing {}: _id={}'
                          .format(etype, getattr(ent, '_id', '?')))
                except Exception as e:
                    print('[DBG] Delete {} failed: {}'.format(etype, e))

        alloc = _allocate_ntf_sids()
        print('[DBG] 分配 SID：TABLED1={}, TABDMP1(Struct)={}, '
              'TABDMP1(Fluid)={}, FREQ1={}, EIGRL(Struct)={}, EIGRL(Fluid)={}'
              .format(alloc['tabled'], alloc['tabdmp_struct'],
                      alloc['tabdmp_fluid'], alloc['freq'],
                      alloc['eigl_struct'], alloc['eigl_fluid']))

        nas_text = _build_common_cards_nas(
            alloc, f1, df, ndf,
            damp_struct, v2_struct,
            damp_fluid, v2_fluid,
            tx1, ty1, tx2, ty2)
        print('[DBG] 生成 .nas 内容:')
        print(nas_text)

        # ★ 统一走 _import_bulk_text（对齐 IPI / VTF）
        _import_bulk_text(nas_text, 'ntf_init_cards')

        _find_cards_in_model(alloc)

        # ★ v4-fix-merge-v2：移除此调用（PARAM + ACMODL 改由 create_header 写）
        # _ensure_params_in_bulk()

        ok_count = sum([
            1 if _STATE['tabled_ent']         else 0,
            1 if _STATE['tabdmp1_struct_tid'] else 0,
            1 if _STATE['tabdmp1_fluid_tid']  else 0,
            1 if _STATE['freq1_sid']          else 0,
            1 if _STATE['eigl_struct_sid']    else 0,
            1 if _STATE['eigl_fluid_sid']     else 0,
        ])
        print('[DBG] 就绪：TABLED={}, TABDMP1(S)={}, TABDMP1(F)={}, '
              'FREQ1={}, EIGRL(S)={}, EIGRL(F)={}'
              .format(
                  'OK' if _STATE['tabled_ent']         else 'MISSING',
                  'OK' if _STATE['tabdmp1_struct_tid'] else 'MISSING',
                  'OK' if _STATE['tabdmp1_fluid_tid']  else 'MISSING',
                  'OK' if _STATE['freq1_sid']          else 'MISSING',
                  'OK' if _STATE['eigl_struct_sid']    else 'MISSING',
                  'OK' if _STATE['eigl_fluid_sid']     else 'MISSING',
              ))

        if ok_count == 6:
            _info('NTF 公共卡片初始化成功。')
        else:
            _warn('只有 {} / 6 张卡片导入成功。'.format(ok_count))

    except Exception as e:
        import traceback
        print('[ERR] init_common_cards exception:')
        print(traceback.format_exc())
        _warn('初始化失败：{}'.format(e))


