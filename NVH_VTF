def create_header(w, data):
    """[4] 写 SOL 111 VTF Header（只写 CEND 段 + PARAM 追加）。

    ★ v13-fix-merge-v2 修复：
        · PARAM 直接写进 Header 文本（放在 SUBCASE 之后）
        · 移除 _ensure_params_in_bulk() 调用
          —— 因为 ANSA 把 PARAM 归到 Header 里，
             而此函数会删除所有旧 Header，
             导致之前导入的 PARAM 一起被删。
        · NSMADD 保持走 InputNastran（NSMADD 是独立实体，不会丢）
    """
    try:
        _dedupe_state()

        if not _STATE['rload1s']:
            _warn('请先执行 "2. Create RLOAD"。')
            return
        if (_STATE['freq1_sid']   is None or
            _STATE['eigl_sid']    is None or
            _STATE['tabdmp1_tid'] is None):
            _warn('模型里缺少 FREQ1 / TABDMP1 / EIGRL。\n'
                  '请先点 "0. Init Common Cards"。')
            return
        if not _STATE['response_nids']:
            _warn('没有响应点，请先执行 "3. Response Nodes"。')
            return

        _rebuild_response_set()

        resp_sid = _STATE['response_sid']
        if resp_sid is None:
            _warn('VTF_RESPONSE SET 未建立，无法写 Header。')
            return

        out_kw = _get_output_keyword()
        print('[DBG] 输出类型关键字（完整）：{}'.format(out_kw))
        print('[DBG] 响应 SET SID = {}, 响应点数 = {}'
              .format(resp_sid, len(_STATE['response_nids'])))

        # ★ v13-fix-merge-v2：移除 _ensure_params_in_bulk() 调用
        # _ensure_params_in_bulk()

        # NSMADD 走 InputNastran（独立实体，不会被删除 Header 时误删）
        nsm_sid = _nsm_ensure_nsmadd()
        print('[DBG] NSM SID（用于 CEND）= {}'.format(nsm_sid))

        # 删除旧 Header
        headers = _collect('Nastran Header')
        print('[DBG] 发现已有 Header 数量：{}'.format(len(headers)))
        for h in headers:
            try:
                base.DeleteEntity(h)
                print('[DBG]   removed Header: _id={}'
                      .format(getattr(h, '_id', '?')))
            except Exception as e:
                print('[DBG]   delete Header failed: {}'.format(e))

        header = base.CreateEntity(constants.NASTRAN, 'Nastran Header')
        if not header:
            _warn('Header 创建失败。')
            return

        # ---- ★ 只写 CEND 段 + PARAM 追加 ----
        lines = [
            'SOL 111',
            'CEND',
            '$=======================================================================',
            'ECHO = NONE',
            'FREQ = {}'.format(_STATE['freq1_sid']),
        ]
        if nsm_sid is not None:
            lines.append('NSM = {}'.format(nsm_sid))
        lines.append('$')
        lines.append('METHOD(STRUCTURE) = {}'.format(_STATE['eigl_sid']))
        lines.append('SDAMPING(STRUCTURE) = {}'.format(_STATE['tabdmp1_tid']))
        lines.append('$')

        for idx, rload in enumerate(_STATE['rload1s'], start=1):
            lines.append('SUBCASE {}'.format(idx))
            lines.append('LABEL = {}'.format(rload['loadset_name']))
            lines.append('DLOAD = {}'.format(rload['loadset_id']))
            lines.append(
                '{}(SORT2, PUNCH, PHASE) = {}'.format(out_kw, resp_sid))

        # ★ v13-fix-merge-v2：PARAM 直接追加在 Header 文本末尾
        #   （ANSA 导出时会自动把 PARAM 放到 .bdf 的 BULK 段正确位置）
        lines.append('$')
        lines.append('PARAM,FASTFR,AUTO')
        lines.append('PARAM,POST,-1')
        lines.append('PARAM,AMSES,YES')
        lines.append('PARAM,AUTOSPC,YES')
        lines.append('PARAM,CHECKEL,YES')

        text = '\n'.join(lines)
        print('[DBG] Header（只写 CEND + PARAM）:\n{}'.format(text))

        base.SetNastranHeaderText(header, text)
        base.SetCurrentEntity(header)

        nsm_msg = ('NSM = {}'.format(nsm_sid)
                   if nsm_sid is not None else '无')

        _info('VTF Header 写入完成（v13-fix-merge-v3）：\n'
              '  SUBCASE 数        = {}\n'
              '  响应 SET SID      = {}（{} 个响应点，共享）\n'
              '  输出类型          = {}\n'
              '  METHOD(STRUCTURE) = {}\n'
              '  SDAMPING(STRUCT)  = {}\n'
              '  FREQ              = {}\n'
              '  {}\n'
              '  PARAM             = FASTFR / POST=-1 / AMSES / AUTOSPC / CHECKEL（写入 Header）'
              .format(len(_STATE['rload1s']),
                      resp_sid,
                      len(_STATE['response_nids']),
                      out_kw,
                      _STATE['eigl_sid'],
                      _STATE['tabdmp1_tid'],
                      _STATE['freq1_sid'],
                      nsm_msg))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('Create Header 失败：{}'.format(e))
