                                    str(msg), True)
    except Exception:
        print('[INFO] ' + str(msg))


def _clear_selection():
    try:
        fn = getattr(base, 'ClearSelection', None)
        if fn:
            fn()
            return
    except Exception:
        pass
    try:
        grids = base.CollectEntities(constants.NASTRAN, None, 'GRID')
        for g in grids:
            try:
                base.SelectEntity(g, False)
            except Exception:
                pass
    except Exception:
        pass


def _pick_grids():
    _clear_selection()
    try:
        base.SetPickMethod(base.constants.ENT_SELECTION)
    except Exception:
        pass
    try:
        nodes = base.PickEntities(constants.NASTRAN, 'GRID')
    except Exception as e:
        print('[DBG] PickEntities failed: {}'.format(e))
        return []
    return list(nodes) if nodes else []


def _collect(entity_type):
    try:
        return base.CollectEntities(constants.NASTRAN, None, entity_type)
    except Exception:
        return []


def _get_card_sid(ent, *field_names):
    if ent is None:
        return None
    names = list(field_names) if field_names else ['SID', 'TID', 'ID']
    for fn in names:
        try:
            vals = base.GetEntityCardValues(constants.NASTRAN, ent, (fn,))
        except Exception:
            continue
        if not vals:
            continue
        v = vals.get(fn)
        if v is None or v == '':
            continue
        return getattr(v, '_id', v)
    return getattr(ent, '_id', None)


def _get_entity_name(ent):
    if ent is None:
        return None
    try:
        nm = base.GetEntityName(ent)
        if nm:
            return nm
    except Exception:
        pass
    try:
        nm = base.GetEntityCardValues(
            constants.NASTRAN, ent, ('Name',)).get('Name')
        if nm:
            return nm
    except Exception:
        pass
    return None


def _get_output_keyword():
    kind_w = _STATE.get('out_widget')
    if not kind_w:
        return 'ACCELERATION'
    kind, w = kind_w
    txt = ''
    if kind == 'edit':
        try:
            txt = guitk.BCLineEditGetText(w) or ''
        except Exception as e:
            print('[DBG] BCLineEditGetText failed: {}'.format(e))
    low = str(txt).strip().lower()
    print('[DBG] Output type raw text = {!r}'.format(txt))
    if low.startswith('d'):
        return 'DISPLACEMENT'
    if low.startswith('v'):
        return 'VELOCITY'
    if low.startswith('a'):
        return 'ACCELERATION'
    return 'ACCELERATION'


def _dedupe_state():
    for key in ('dareas', 'rload1s'):
        seen = set()
        unique = []
        for item in _STATE[key]:
            nm = item.get('loadset_name')
            if nm is None or nm in seen:
                continue
            seen.add(nm)
            unique.append(item)
        before = len(_STATE[key])
        _STATE[key] = unique
        if before != len(unique):
            print('[DBG] dedupe {}: {} -> {}'
                  .format(key, before, len(unique)))


def _set_entity_name_safe(ent, name):
    """兼容 ANSA V21.1.5（无 base.SetEntityName），多重 API 兜底。"""
    for tag, fn in (
        ('base.SetEntityName',
            lambda: base.SetEntityName(ent, name)),
        ('SetEntityCardValues(Name)',
            lambda: base.SetEntityCardValues(
                constants.NASTRAN, ent, {'Name': name})),
        ('SetEntityCardValues(NAME)',
            lambda: base.SetEntityCardValues(
                constants.NASTRAN, ent, {'NAME': name})),
    ):
        try:
            fn()
        except Exception as e:
            print('[DBG] {} failed: {}'.format(tag, e))
            continue
        if _get_entity_name(ent) == name:
            print('[DBG] name set via {}'.format(tag))
            return True
        print('[DBG] {} silently did nothing'.format(tag))
    return False


