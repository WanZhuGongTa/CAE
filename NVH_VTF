    return None


def _find_set_by_name(name):
    for s in _collect('SET'):
        if _get_entity_name(s) == name:
            return s
    return None


def _collect_used_set_sids():
    used = set()
    for etype in ('SET',
                  'NSET', 'ESET', 'BSET',
                  'Header Set', 'Element Set', 'Node Set',
                  'NSM Set', 'Group'):
        for s in _collect(etype):
            sid = _get_card_sid(s, 'SID', 'ID')
            if sid is None:
                continue
            try:
                used.add(int(sid))
            except (TypeError, ValueError):
                pass
    return used


def _next_free_set_sid(used):
    n = 1
    while n in used:
        n += 1
    return n


def _delete_response_set():
    if _STATE['response_set'] is not None:
        try:
            base.DeleteEntity(_STATE['response_set'])
            print('[DBG] removed old response SET (from state)')
        except Exception as e:
            print('[DBG] delete old response SET failed: {}'.format(e))
        _STATE['response_set'] = None
        _STATE['response_sid'] = None

    for _ in range(5):
        old = _find_set_by_name(RESPONSE_SET_NAME)
        if old is None:
            break
        try:
            base.DeleteEntity(old)
            print('[DBG] removed residual {} SET'.format(RESPONSE_SET_NAME))
        except Exception as e:
            print('[DBG] delete residual SET failed: {}'.format(e))
            break


def _rebuild_response_set():
    """全量重建 VTF_RESPONSE SET。
    分步创建 + 多重 API 兜底，兼容 ANSA V21.1.5。

    ★ v13-fix-merge-v3：AddToSet 由「一次性传列表」改为「逐个 GRID 调用」。
       原因：某些 ANSA 版本对 AddToSet(set, [list]) 不报错但只加第一个实体，
             导致框选多个响应点时 SET 里只写进 1 个点。
    """
    _delete_response_set()

    if not _STATE['response_nids']:
        print('[DBG] no response nodes → SET not created')
        return

    used = _collect_used_set_sids()
    sid  = _next_free_set_sid(used)
    print('[DBG] 分配 {} SID = {}'.format(RESPONSE_SET_NAME, sid))

    set_ent = base.CreateEntity(constants.NASTRAN, 'SET')
    if set_ent is None:
        print('[ERR] SET creation failed')
        return

    try:
        base.SetEntityCardValues(
            constants.NASTRAN, set_ent, {'SID': sid})
    except Exception as e:
        print('[DBG] SetEntityCardValues SID failed: {}'.format(e))

    if not _set_entity_name_safe(set_ent, RESPONSE_SET_NAME):
        print('[ERR] Cannot set name for SET {!r}, will delete'
              .format(RESPONSE_SET_NAME))
        try:
            base.DeleteEntity(set_ent)
        except Exception:
            pass
        return

    grids = []
    for nid in sorted(_STATE['response_nids']):
        g = _find_grid_by_nid(nid)
        if g is not None:
            grids.append(g)
        else:
            print('[WARN] Response GRID NID={} not found'.format(nid))

    if grids:
        # ★ v13-fix-merge-v3：逐个添加，避免一次性传列表时"静默只加第一个"
        n_added = 0
        for g in grids:
            ok_one = False
            for call in (
                lambda gg=g: base.AddToSet(set_ent, gg),
                lambda gg=g: base.AddToSet(set_ent, [gg]),
            ):
                try:
                    call()
                    ok_one = True
                    break
                except Exception as e:
                    print('[DBG] AddToSet variant failed: {}'.format(e))
            if ok_one:
                n_added += 1
            else:
                try:
                    nid_dbg = base.GetEntityCardValues(
                        constants.NASTRAN, g, ('NID',)).get('NID')
                except Exception:
                    nid_dbg = '?'
                print('[WARN] AddToSet failed for GRID NID={}'
                      .format(nid_dbg))

        print('[DBG] AddToSet: {}/{} grids added to {}'
              .format(n_added, len(grids), RESPONSE_SET_NAME))
        if n_added != len(grids):
            print('[ERR] {} SET 只加入了 {}/{} 个节点'
                  .format(RESPONSE_SET_NAME, n_added, len(grids)))

    actual = _get_card_sid(set_ent, 'SID', 'ID')
    try:
        if actual is not None and int(actual) != int(sid):
            print('[WARN] SET SID mismatch: assigned={}, actual={}'
                  .format(sid, actual))
            sid = actual
    except (TypeError, ValueError):
        pass

    _STATE['response_set'] = set_ent
    _STATE['response_sid'] = sid
    print('[DBG] {} SET created: SID={}, {} nodes'
          .format(RESPONSE_SET_NAME, sid, len(grids)))


