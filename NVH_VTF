        print('[DBG] 生成 .nas 内容:')
        print(nas_text)

        # ★ 用统一入口导入（对齐 IPI）
        _import_bulk_text(nas_text, 'init_cards')

        _find_cards_in_model()

        # ★ v13-fix-merge-v2：移除此调用（PARAM 改由 create_header 写）
        # _ensure_params_in_bulk()

        ok_count = sum([
            1 if _STATE['tabled_ent']  else 0,
            1 if _STATE['tabdmp1_tid'] else 0,
            1 if _STATE['freq1_sid']   else 0,
            1 if _STATE['eigl_sid']    else 0,
