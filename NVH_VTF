        print('[DBG] Cleared {} response SET'.format(n))
        _info('已清除 {} 个 NTF_RESPONSE SET，响应点列表已清空。'.format(n))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('清除响应 SET 失败：{}'.format(e))


