def _create_eigr_widget(layout, default_value='EIGRL'):
    """尝试创建 ComboBox；失败则退回 LineEdit。
    返回 (kind, widget) —— kind 为 'combo' 或 'edit'。
    """
    items = ['EIGRL', 'EIGRA']
    for tag, fn in (
        ('BCComboBoxCreate(items=)',
            lambda: guitk.BCComboBoxCreate(layout, items,
                                           setCurrentText=default_value)),
        ('BCComboBoxCreate(default_index=)',
            lambda: guitk.BCComboBoxCreate(layout, items, False,
                                           setCurrentText=default_value)),
        ('BCComboBoxCreate(pos)',
            lambda: guitk.BCComboBoxCreate(layout, items)),
    ):
        try:
            w = fn()
            if w is not None:
                print('[DBG] ComboBox created via {}'.format(tag))
                return ('combo', w)
        except Exception as e:
            print('[DBG] {} failed: {}'.format(tag, e))
            continue

    print('[WARN] ComboBox 创建失败，退回 LineEdit')
    try:
        w = guitk.BCLineEditCreate(layout, default_value)
        return ('edit', w)
    except Exception as e:
        print('[ERR] LineEdit 也失败: {}'.format(e))
        return (None, None)


