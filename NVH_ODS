def _import_bulk_text(bulk_text, tag='bulk'):
    if not bulk_text or not bulk_text.strip():
        print('[ERR] _import_bulk_text: empty text for tag={}'.format(tag))
        return False
    tmp = os.path.join(tempfile.gettempdir(), '_{}.nas'.format(tag))
    try:
        with open(tmp, 'w') as f:
            f.write(bulk_text)
        print('[DBG] === import {} begin ==='.format(tag))
        print(bulk_text)
        print('[DBG] === import {} end   ==='.format(tag))
        r = base.InputNastran(tmp)
        print('[DBG] InputNastran({}) -> {}'.format(tag, r))
        return True
    except Exception as e:
        print('[ERR] import {} failed: {}'.format(tag, e))
        import traceback
        print(traceback.format_exc())
        return False
    finally:
        try:
            os.remove(tmp)
        except Exception:
            pass


