# ---------------------------------------------------------------------------
#  DLOAD 相关函数（v12 起不再使用，保留仅为兼容）
# ---------------------------------------------------------------------------
def _collect_used_dload_sids():
    used = set()
    for ent in _collect('DLOAD'):
        sid = _get_card_sid(ent, 'SID', 'ID')
        if sid is None:
            continue
        try:
            used.add(int(sid))
        except (TypeError, ValueError):
            pass
    return used


def _allocate_dload_sids(count):
    used = _collect_used_dload_sids()
    sids = []
    n = 1
    for _ in range(count):
        while n in used:
            n += 1
        sids.append(n)
        used.add(n)
        n += 1
    return sids


def _build_dload_text(sid, rload_list):
    fields = [str(sid), '1.0']
    for r in rload_list:
        fields.append(str(r['loadset_id']))
        fields.append('1.0')

    lines = []
    first_chunk = fields[:7]
    lines.append('DLOAD,' + ','.join(first_chunk))
    rest = fields[7:]
    while rest:
        chunk = rest[:8]
        lines.append('+,' + ','.join(chunk))
        rest = rest[8:]
    return lines


def _delete_all_dloads():
    n = 0
    for d in _collect('DLOAD'):
        try:
            base.DeleteEntity(d)
            n += 1
        except Exception as e:
            print('[DBG] delete DLOAD failed: {}'.format(e))
    if n > 0:
        print('[DBG] Removed {} old DLOAD cards'.format(n))


