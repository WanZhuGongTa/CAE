def _nsm_get_sid_from_card(ent, field='SID'):
    if ent is None:
        return None
    try:
        vals = base.GetEntityCardValues(constants.NASTRAN, ent, (field,))
    except Exception:
        return None
    v = vals.get(field)
    if v is None or v == '':
        return None
    v = getattr(v, '_id', v)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _nsm_collect_nsm_sids():
    sids = []
    for ent in _collect('NSM'):
        sid = _nsm_get_sid_from_card(ent, 'SID')
        if sid is not None and sid not in sids:
            sids.append(sid)
    return sids


def _nsm_collect_nsmadd_sids():
    sids = []
    for ent in _collect('NSMADD'):
        sid = _nsm_get_sid_from_card(ent, 'SID')
        if sid is not None:
            sids.append(sid)
    return sids


def _nsm_ensure_nsmadd():
    nsm_sids = _nsm_collect_nsm_sids()
    nsmadd_sids = _nsm_collect_nsmadd_sids()

    print('[DBG] NSM: 模型里 NSM SID = {}'.format(nsm_sids))
    print('[DBG] NSM: 模型里 NSMADD SID = {}'.format(nsmadd_sids))

    if nsmadd_sids:
        ref_sid = max(nsmadd_sids)
        print('[DBG] NSM: 检测到已有 NSMADD，引用 SID = {}'.format(ref_sid))
        return ref_sid

    if not nsm_sids:
        print('[DBG] NSM: 无 NSM 且无 NSMADD，跳过')
        return None

    used = set(nsm_sids) | set(nsmadd_sids)
    new_sid = 1
    while new_sid in used:
        new_sid += 1

    fields = [str(new_sid)] + [str(s) for s in nsm_sids]
    lines = ['BEGIN BULK']
    first = fields[:8]
    lines.append('NSMADD,' + ','.join(first))
    rest = fields[8:]
    while rest:
        chunk = rest[:8]
        lines.append('+,' + ','.join(chunk))
        rest = rest[8:]
    lines.append('ENDDATA')

    print('[DBG] NSM: 无 NSMADD，新建 NSMADD (SID={}) 合并 {}'
          .format(new_sid, nsm_sids))

    if _import_bulk_text('\n'.join(lines) + '\n', 'nsmadd'):
        return new_sid
    return None


