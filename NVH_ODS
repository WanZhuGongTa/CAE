#  [4] Create Header（★ v13：位移 + 应变能）
# ---------------------------------------------------------------------------
def create_header(w, data):
    try:
        _dedupe_state()

        if not _STATE['rload1s']:
            _warn('请先执行 "2. Create RLOAD"。')
            return
        if (_STATE['freq_sid']    is None or
            _STATE['eigl_sid']    is None or
            _STATE['tabdmp1_tid'] is None):
            _warn('模型里缺少 FREQ / TABDMP1 / EIGRL 或 EIGRA。\n'
                  '请先点 "0. Init Common Cards"。')
            return

        use_all = bool(_STATE.get('response_all', False))

        if use_all:
            print('[DBG] 响应模式：全模型（无 SET）')
            resp_sid = None
        else:
            if not _STATE['response_nids']:
                _warn('没有响应点，请先执行 "3. Response Nodes" 或 '
                      '"3b. Response All (Fast)"。')
                return

            _rebuild_response_set()

            resp_sid = _STATE['response_sid']
            if resp_sid is None:
                _warn('ODS_RESPONSE SET 未建立，无法写 Header。')
                return

            resp_set_ent = _STATE['response_set']
            if resp_set_ent is None:
                _warn('ODS_RESPONSE SET 实体为空，无法写 Header。')
                return

        out_kw    = _get_output_keyword()
        eigr_type = _get_eigr_type()
        print('[DBG] 输出类型 = {}, 模态方法 = {}, EIGR SID = {}'
              .format(out_kw, eigr_type, _STATE['eigl_sid']))

        print('[DBG] 激励点-方向组合数：{}'.format(len(_STATE['rload1s'])))
        for r in _STATE['rload1s']:
            print('[DBG]   PT{} {} RLOAD1(SID={})'.format(
                r.get('node_id', '?'), r.get('dir_name', '?'),
                r.get('rload_sid', '?')))

        nsm_sid = _nsm_ensure_nsmadd()
        print('[DBG] NSM SID（用于 CEND）= {}'.format(nsm_sid))

        _delete_all_dloads()

        headers = _collect('Nastran Header')
        print('[DBG] 发现已有 Header 数量：{}'.format(len(headers)))
        for h in headers:
            try:
                base.DeleteEntity(h)
                print('[DBG]   removed Header: _id={}'
                      .format(getattr(h, '_id', '?')))
            except Exception as e:
                print('[DBG]   delete Header failed: {}'.format(e))

        header = base.CreateEntity(constants.NASTRAN, 'Nastran Header')
        if not header:
            _warn('Header 创建失败。')
            return

        lines = [
            'SOL 111',
            'CEND',
            '$=======================================================================',
            'ECHO = NONE',
            'FREQ = {}'.format(_STATE['freq_sid']),
        ]
        if nsm_sid is not None:
            lines.append('NSM = {}'.format(nsm_sid))
        lines.append('$')
        lines.append('METHOD(STRUCTURE) = {}'.format(_STATE['eigl_sid']))
        lines.append('SDAMPING(STRUCTURE) = {}'.format(_STATE['tabdmp1_tid']))
        lines.append('$')

        subcase_idx = 0
        subcase_labels = []
        for r in _STATE['rload1s']:
            rload_sid = r.get('rload_sid')
            if rload_sid is None:
                print('[WARN] RLOAD1 SID 缺失，跳过：{}'
                      .format(r.get('loadset_name', '?')))
                continue

            node_id  = r.get('node_id', 'NA')
            dir_name = r.get('dir_name', 'NA')
            label    = 'ODS_PT{}_{}'.format(node_id, dir_name)
            subcase_idx += 1
            subcase_labels.append(label)

            lines.append('SUBCASE {}'.format(subcase_idx))
            lines.append('LABEL = {}'.format(label))
            lines.append('DLOAD = {}'.format(rload_sid))

            if use_all:
                lines.append('{}(PLOT, SORT1, PHASE)'.format(out_kw))
            else:
                lines.append(
                    '{}(PLOT, SORT1, PHASE) = {}'.format(out_kw, resp_sid))

            lines.append('ESE(PLOT) = ALL')

            lines.append('$')

        lines.append('PARAM,FASTFR,AUTO')
        lines.append('PARAM,POST,-1')
        lines.append('PARAM,AMSES,YES')
        lines.append('PARAM,AUTOSPC,YES')
        lines.append('PARAM,CHECKEL,YES')

        text = '\n'.join(lines)
        print('[DBG] Header（v14）:\n{}'.format(text))

        base.SetNastranHeaderText(header, text)
        base.SetCurrentEntity(header)

        nsm_msg = ('NSM = {}'.format(nsm_sid)
                   if nsm_sid is not None else '无')

        if use_all:
            resp_msg = 'ALL（全模型，无 SET）'
        else:
            resp_msg = 'SET SID={}（{} 个响应点）'.format(
                resp_sid, len(_STATE['response_nids']))

        preview = ', '.join(subcase_labels[:6])
        if len(subcase_labels) > 6:
            preview += ' ...'

        _info('ODS Header 写入完成（v14）：\n'
              '  SUBCASE 数        = {}（每 (点, 方向) 一个）\n'
              '  SUBCASE LABEL     = {}\n'
              '  FREQ SID          = {}\n'
              '  模态方法          = {}\n'
              '  EIGR SID          = {}\n'
              '  响应模式          = {}\n'
              '  输出类型          = {}（位移）\n'
              '  ★ 应变能输出      = ESE(PLOT) = ALL\n'
              '  SDAMPING(STRUCT)  = {}\n'
              '  {}\n'
              '  PARAM             = FASTFR / POST=-1 / AMSES / AUTOSPC / CHECKEL\n'
              '  DLOAD             = 0 张（每个 SUBCASE 直接引用 RLOAD1）'
              .format(subcase_idx,
                      preview,
                      _STATE['freq_sid'],
                      eigr_type,
                      _STATE['eigl_sid'],
                      resp_msg,
                      out_kw,
                      _STATE['tabdmp1_tid'],
                      nsm_msg))
    except Exception as e:
        import traceback
        print('[ERR] create_header exception:')
        print(traceback.format_exc())
        _warn('Create Header 失败：{}'.format(e))
