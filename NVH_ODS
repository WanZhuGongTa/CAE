def _collect_used_sids(etype_list):
    used = set()
    for etype in etype_list:
        for ent in _collect(etype):
            sid = _get_card_sid(ent)
            if sid is None:
                continue
            try:
                used.add(int(sid))
            except (TypeError, ValueError):
                pass
    return used


def _next_free_sid(etype_list):
    used = _collect_used_sids(etype_list)
    n = 1
    while n in used:
        n += 1
    return n


# ★ v14：支持 EIGRA
def _allocate_common_sids(eigr_type='EIGRL'):
    tabled_sid = _next_free_sid(['TABLED1', 'TABLED'])
    tabdmp_sid = _next_free_sid(['TABDMP1', 'TABDMP', 'TABDMP0'])
    freq_sid   = _next_free_sid(['FREQ'])
    if eigr_type == 'EIGRA':
        eigl_sid = _next_free_sid(['EIGRA'])
    else:
        eigl_sid = _next_free_sid(['EIGRL', 'EIGR'])
    return tabled_sid, tabdmp_sid, freq_sid, eigl_sid


def _create_freq_entity(sid, freq_list):
    if len(freq_list) > 10:
        print('[WARN] FREQ 频率数 = {}，超过 ANSA FREQ 卡片 F1~F10 上限，'
              '仅取前 10 个'.format(len(freq_list)))
        freq_list = freq_list[:10]

    fields = {
        'SID':           int(sid),
        'No.of.Values':  int(len(freq_list)),
    }
    for i, f in enumerate(freq_list, start=1):
        fields['F{}'.format(i)] = float(f)
    print('[DBG] CreateEntity FREQ fields = {}'.format(fields))

    ent, report = base.CreateEntity(
        constants.NASTRAN, 'FREQ', fields,
        debug=constants.REPORT_ALL
    )
    if ent is None:
        print('[ERR] FREQ create failed:')
        for k, v in (report or {}).items():
            print('       {}: {}'.format(k, v))
        return None

    print('[DBG] FREQ created: _id={}'.format(getattr(ent, '_id', None)))

    try:
        check_fields = ['SID', 'No.of.Values'] + \
                       ['F{}'.format(i) for i in range(1, len(freq_list) + 1)]
        check = base.GetEntityCardValues(
            constants.NASTRAN, ent, tuple(check_fields))
        print('[DBG] FREQ 回读校验 = {}'.format(check))
    except Exception as e:
        print('[DBG] FREQ 回读失败：{}'.format(e))

    return ent


# ★ v14：支持 EIGRA
def _build_common_cards_nas_no_freq(tabled_sid, tabdmp_sid, eigl_sid,
                                    damp, v2, tx1, ty1, tx2, ty2,
                                    eigr_type='EIGRL'):
    lines = []
    lines.append('BEGIN BULK')

    lines.append('TABLED1,{},LINEAR,LINEAR'.format(tabled_sid))
    lines.append('+,{},{},{},{},ENDT'.format(tx1, ty1, tx2, ty2))

    lines.append('TABDMP1,{},G'.format(tabdmp_sid))
    lines.append('+,{},{},{},{},ENDT'.format(tx1, damp, tx2, damp))

    if eigr_type == 'EIGRA':
        lines.append('EIGRA,{},0.0,{}'.format(eigl_sid, v2))
    else:
        lines.append('EIGRL,{},0.0,{}'.format(eigl_sid, v2))

    lines.append('ENDDATA')
    return '\n'.join(lines) + '\n'


# ★ v14：支持 EIGRA
def _find_cards_in_model(eigr_type='EIGRL'):
    tabs = _collect('TABLED1') or _collect('TABLED')
    if tabs:
        _STATE['tabled_ent'] = tabs[0]
        print('[DBG] Found TABLED1: SID/TID={}'
              .format(_get_card_sid(tabs[0], 'TID', 'SID', 'ID')))

    for name in ('TABDMP1', 'TABDMP', 'TABDMP0'):
        ents = _collect(name)
        if ents:
            sid = _get_card_sid(ents[0], 'TID', 'SID', 'ID')
            _STATE['tabdmp1_tid'] = sid
            print('[DBG] Found {}: SID/TID={}'.format(name, sid))
            break

    ents = _collect('FREQ')
    if ents:
        sid = _get_card_sid(ents[0], 'SID', 'ID')
        _STATE['freq_sid'] = sid
        print('[DBG] Found FREQ: SID={}'.format(sid))

    search = ['EIGRA', 'EIGRL', 'EIGR'] if eigr_type == 'EIGRA' \
        else ['EIGRL', 'EIGR', 'EIGRA']
    found = None
    for name in search:
        ents = _collect(name)
        if ents:
            found = _get_card_sid(ents[0], 'SID', 'TID', 'ID')
            print('[DBG] Found {}: SID={}'.format(name, found))
            break

    if found is not None:
        _STATE['eigl_sid'] = found
    else:
        _STATE['eigl_sid'] = _STATE.get('eigl_allocated')
        print('[DBG] WARN: 未找到 {}，保留已分配 SID = {}'
              .format(eigr_type, _STATE['eigl_sid']))


def init_common_cards(w, data):
    try:
        print('[DBG] ============================================')
        print('[DBG] ODS Init Common Cards clicked')

        model_dareas = _collect('DAREA')
        if not model_dareas and _STATE['dareas']:
            print('[DBG] 模型里无 DAREA 但缓存有 {} 条记录，'
                  '判定为新模型，清空缓存'.format(len(_STATE['dareas'])))
            _STATE['dareas'] = []
            _STATE['rload1s'] = []

        freq_edit, damp_edit, eigr_type_widget, eigl_edit, tab_edit = data

        text_freq = guitk.BCLineEditGetText(freq_edit)
        parts = re.findall(r'[-+]?\d*\.?\d+', text_freq)
        if not parts:
            _warn('FREQ 输入为空或未包含有效数字')
            return
        try:
            freq_list = [float(p) for p in parts]
        except ValueError as e:
            _warn('FREQ 频率解析失败：{}'.format(e))
            return
        if any(f <= 0 for f in freq_list):
            _warn('FREQ 频率值必须大于 0')
            return

        damp = guitk.BCLineEditGetDouble(damp_edit)
        if damp <= 0:
            _warn('阻尼比必须大于 0')
            return

        # ★ v14：读取 EIGR 类型
        eigr_type = _get_eigr_type()
        print('[DBG] Modes Method = {}'.format(eigr_type))

        v2 = guitk.BCLineEditGetDouble(eigl_edit)
        if v2 <= 0:
            _warn('EIGRL 上限频率必须大于 0')
            return

        text_tab = guitk.BCLineEditGetText(tab_edit)
        parts_t = re.findall(r'[-+]?\d*\.?\d+', text_tab)
        if len(parts_t) != 4:
            _warn('TABLED1 格式应为 "x1, y1, x2, y2"，且必须包含 4 个数值')
            return
        try:
            tx1, ty1, tx2, ty2 = [float(p) for p in parts_t]
        except ValueError as e:
            _warn('TABLED1 解析失败：{}'.format(e))
            return

        print('[DBG] 参数：FREQ={}, damp={}, V2={}, TABLED=({},{},{},{})'
              .format(freq_list, damp, v2, tx1, ty1, tx2, ty2))
        print('[DBG] 当前输出类型：{}'.format(_get_output_keyword()))
        print('[DBG] 当前激励方向：{}'.format(_get_selected_directions()))

        for etype in ('TABLED1', 'TABLED',
                      'TABDMP', 'TABDMP1',
                      'FREQ', 'FREQ1',
                      'EIGRL', 'EIGR', 'EIGRA'):
            for ent in _collect(etype):
                try:
                    base.DeleteEntity(ent)
                    print('[DBG] Deleted existing {}: _id={}'
                          .format(etype, getattr(ent, '_id', '?')))
                except Exception as e:
                    print('[DBG] Delete {} failed: {}'.format(etype, e))

        tabled_sid, tabdmp_sid, freq_sid, eigl_sid = _allocate_common_sids(eigr_type)
        print('[DBG] 分配 SID：TABLED1={}, TABDMP1={}, FREQ={}, {}({})={}'
              .format(tabled_sid, tabdmp_sid, freq_sid,
                      eigr_type, eigl_sid, eigl_sid))

        _STATE['eigl_allocated'] = eigl_sid
        _STATE['freq_sid']       = freq_sid
        _STATE['tabdmp1_tid']    = tabdmp_sid

        nas_text = _build_common_cards_nas_no_freq(
            tabled_sid, tabdmp_sid, eigl_sid,
            damp, v2, tx1, ty1, tx2, ty2, eigr_type)
        print('[DBG] 生成 .nas 内容:')
        print(nas_text)
        _import_bulk_text(nas_text, 'ods_init_cards')

        freq_ent = _create_freq_entity(freq_sid, freq_list)
        if freq_ent is None:
            _warn('FREQ 卡片创建失败，请查看控制台日志。')
            return

        _find_cards_in_model(eigr_type)

        ok_count = sum([
            1 if _STATE['tabled_ent']  else 0,
            1 if _STATE['tabdmp1_tid'] else 0,
            1 if _STATE['freq_sid']    else 0,
            1 if _STATE['eigl_sid']    else 0,
        ])
        print('[DBG] 就绪：TABLED={}, TABDMP={}, FREQ={}, {}={}'
              .format(
                  'OK' if _STATE['tabled_ent']  else 'MISSING',
                  'OK' if _STATE['tabdmp1_tid'] else 'MISSING',
                  'OK' if _STATE['freq_sid']    else 'MISSING',
                  eigr_type,
                  'OK' if _STATE['eigl_sid']    else 'MISSING',
              ))

        if ok_count == 4:
            _info('ODS 公共卡片初始化成功。\n'
                  '模态方法 = {}\n'
                  'FREQ 包含 {} 个离散频率点。'
                  .format(eigr_type, len(freq_list)))
        else:
            _warn('只有 {} / 4 张卡片导入成功。'.format(ok_count))

    except Exception as e:
        import traceback
        print('[ERR] init_common_cards exception:')
        print(traceback.format_exc())
        _warn('初始化失败：{}'.format(e))


