def on_response_nodes(w, data):
    try:
        print('[DBG] ============================================')
        print('[DBG] ODS Response Nodes (Pick) clicked')

        _STATE['response_all'] = False

        nodes = _pick_grids()
        print('[DBG] picked GRID count = {}'.format(len(nodes)))
        if not nodes:
            _warn('未选中任何节点。')
            return

        nid_list = _print_picked_nodes(nodes)

        added = 0
        for nid in nid_list:
            if nid not in _STATE['response_nids']:
                _STATE['response_nids'].add(nid)
                added += 1

        print('[DBG] 本次新增 {} 个响应点，累计 {}'.format(
            added, len(_STATE['response_nids'])))

        _rebuild_response_set()

        _info('本次拾取 {} 个节点，其中 {} 个为新增响应点。\n'
              '当前累计 {} 个响应点，ODS_RESPONSE SET SID = {}。'
              .format(len(nid_list), added,
                      len(_STATE['response_nids']),
                      _STATE['response_sid']))
    except Exception as e:
        import traceback
        print('[ERR] on_response_nodes exception:')
        print(traceback.format_exc())
        _warn('Response Nodes 操作失败：{}'.format(e))


