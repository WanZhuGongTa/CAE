def create_rload1(w, data):
    try:
        print('[DBG] ============================================')
        print('[DBG] ODS Create RLOAD clicked')
        _dedupe_state()

        if not _STATE['dareas']:
            _warn('没有可用的 DAREA，请先执行 "1. DAREA Nodes"。')
            return

        if _STATE['tabled_ent'] is None:
            _find_cards_in_model(_get_eigr_type())
        if _STATE['tabled_ent'] is None:
            _warn('模型里没有 TABLED1。请先点 "0. Init Common Cards"。')
            return

        existing_rload_names = {r['loadset_name'] for r in _STATE['rload1s']}
        pending = [d for d in _STATE['dareas']
                   if not d['has_rload1']
                   and d['loadset_name'] not in existing_rload_names]
        print('[DBG] 待处理 DAREA 数量：{}（累计 {}）'
              .format(len(pending), len(_STATE['dareas'])))
        if not pending:
            _warn('没有新增的 DAREA，所有 DAREA 都已关联 RLOAD1。')
            return

        count = 0
        for darea in pending:
            rload = _create_rload1_for_darea(darea, _STATE['tabled_ent'])
            if rload is None:
                continue
            darea['has_rload1'] = True

            rload_sid = _get_card_sid(rload, 'SID', 'ID')
            if rload_sid is None:
                rload_sid = darea['loadset_id']
                print('[DBG] RLOAD1 SID 读取失败，兜底用 loadset_id={}'
                      .format(rload_sid))

            _STATE['rload1s'].append({
                'entity':       rload,
                'loadset_name': darea['loadset_name'],
                'loadset_id':   darea['loadset_id'],
                'dir_name':     darea['dir_name'],
                'node_id':      darea['node_id'],
                'rload_sid':    rload_sid,
            })
            count += 1

        _dedupe_state()

        _info('本次共创建 {} 个 RLOAD1。\n'
              '当前累计 {} 个 RLOAD1。'
              .format(count, len(_STATE['rload1s'])))
    except Exception as e:
        import traceback
        print('[ERR] create_rload1 exception:')
        print(traceback.format_exc())
        _warn('Create RLOAD 失败：{}'.format(e))


