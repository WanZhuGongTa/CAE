def _clear_selection():
    try:
        fn = getattr(base, 'ClearSelection', None)
        if fn:
            fn()
            return
    except Exception:
        pass
    try:
        grids = base.CollectEntities(constants.NASTRAN, None, 'GRID')
        for g in grids:
            try:
                base.SelectEntity(g, False)
            except Exception:
                pass
    except Exception:
        pass


def _pick_grids():
    _clear_selection()
    try:
        base.SetPickMethod(base.constants.ENT_SELECTION)
    except Exception:
        pass
    try:
        nodes = base.PickEntities(constants.NASTRAN, 'GRID')
    except Exception as e:
        print('[DBG] PickEntities failed: {}'.format(e))
        return []
    return list(nodes) if nodes else []


def _collect(entity_type):
    try:
        return base.CollectEntities(constants.NASTRAN, None, entity_type)
    except Exception:
        return []


def _get_card_sid(ent, *field_names):
    if ent is None:
        return None
    names = list(field_names) if field_names else ['SID', 'TID', 'ID']
    for fn in names:
        try:
            vals = base.GetEntityCardValues(constants.NASTRAN, ent, (fn,))
        except Exception:
            continue
        if not vals:
            continue
        v = vals.get(fn)
        if v is None or v == '':
            continue
        return getattr(v, '_id', v)
    return getattr(ent, '_id', None)


def _get_entity_name(ent):
    if ent is None:
        return None
    try:
        nm = base.GetEntityName(ent)
        if nm:
            return nm
    except Exception:
        pass
    try:
        nm = base.GetEntityCardValues(
            constants.NASTRAN, ent, ('Name',)).get('Name')
        if nm:
            return nm
    except Exception:
        pass
    return None


def _get_output_keyword():
    kind_w = _STATE.get('out_widget')
    if not kind_w:
        return 'DISPLACEMENT'
    kind, w = kind_w
    txt = ''
    if kind == 'edit':
        try:
            txt = guitk.BCLineEditGetText(w) or ''
        except Exception as e:
            print('[DBG] BCLineEditGetText failed: {}'.format(e))
    low = str(txt).strip().lower()
    print('[DBG] Output type raw text = {!r}'.format(txt))
    if low.startswith('v'):
        return 'VELOCITY'
    if low.startswith('a'):
        return 'ACCELERATION'
    return 'DISPLACEMENT'


# ★ v14：支持 ComboBox 读取
def _get_eigr_type():
    """读取用户选择：EIGRL 或 EIGRA。
    - ComboBox → 尝试多个 API 名读文本，失败读索引
    - LineEdit → BCLineEditGetText
    - 全失败返回 'EIGRL'
    """
    kind_w = _STATE.get('eigr_type_widget')
    if not kind_w:
        return 'EIGRL'
    kind, w = kind_w
    if w is None:
        return 'EIGRL'

    txt = ''
    if kind == 'combo':
        for fn_name in ('BCComboBoxGetText',
                        'BCComboBoxGetCurrentText',
                        'BCComboBoxGetCurrentString',
                        'BCComboBoxGetString'):
            fn = getattr(guitk, fn_name, None)
            if fn is None:
                continue
            try:
                txt = fn(w) or ''
                if txt:
                    print('[DBG] 用 {} 读到 ComboBox 文本 = {!r}'
                          .format(fn_name, txt))
                    break
            except Exception as e:
                print('[DBG] {} failed: {}'.format(fn_name, e))
                continue

        if not txt:
            for fn_name in ('BCComboBoxGetCurrentIndex',
                            'BCComboBoxGetSelectedIndex',
                            'BCComboBoxGetIndex'):
                fn = getattr(guitk, fn_name, None)
                if fn is None:
                    continue
                try:
                    idx = fn(w)
                    if isinstance(idx, int) and idx in (0, 1):
                        txt = 'EIGRA' if idx == 1 else 'EIGRL'
                        print('[DBG] 用 {} 读到索引 {} → {}'
                              .format(fn_name, idx, txt))
                        break
                except Exception as e:
                    print('[DBG] {} failed: {}'.format(fn_name, e))
                    continue
    elif kind == 'edit':
        try:
            txt = guitk.BCLineEditGetText(w) or ''
        except Exception as e:
            print('[DBG] BCLineEditGetText(eigr) failed: {}'.format(e))

    if not txt:
        print('[WARN] 无法读取 Modes Method，默认 EIGRL')
        return 'EIGRL'

    result = 'EIGRA' if str(txt).strip().upper().startswith('EIGRA') else 'EIGRL'
    print('[DBG] Modes Method 最终解析 = {}'.format(result))
    return result


def _get_selected_directions():
    kind_w = _STATE.get('dir_widget')
    if not kind_w:
        return ['X', 'Y', 'Z']
    kind, w = kind_w
    txt = ''
    if kind == 'edit':
        try:
            txt = guitk.BCLineEditGetText(w) or ''
        except Exception as e:
            print('[DBG] BCLineEditGetText(dir) failed: {}'.format(e))

    matches = re.findall(r'[XYZxyz]', str(txt))
    result = []
    for ch in matches:
        ch = ch.upper()
        if ch not in result:
            result.append(ch)

    if not result:
        print('[WARN] Directions 解析为空，默认使用 X,Y,Z')
        return ['X', 'Y', 'Z']
    print('[DBG] Directions parsed = {}'.format(result))
    return result


def _dedupe_state():
    for key in ('dareas', 'rload1s'):
        seen = set()
        unique = []
        for item in _STATE[key]:
            nm = item.get('loadset_name')
            if nm is None or nm in seen:
                continue
            seen.add(nm)
            unique.append(item)
        before = len(_STATE[key])
        _STATE[key] = unique
        if before != len(unique):
            print('[DBG] dedupe {}: {} -> {}'
                  .format(key, before, len(unique)))


def _set_entity_name_safe(ent, name):
    for tag, fn in (
        ('base.SetEntityName',
            lambda: base.SetEntityName(ent, name)),
        ('SetEntityCardValues(Name)',
            lambda: base.SetEntityCardValues(
                constants.NASTRAN, ent, {'Name': name})),
        ('SetEntityCardValues(NAME)',
            lambda: base.SetEntityCardValues(
                constants.NASTRAN, ent, {'NAME': name})),
    ):
        try:
            fn()
        except Exception as e:
            print('[DBG] {} failed: {}'.format(tag, e))
            continue
        if _get_entity_name(ent) == name:
            print('[DBG] name set via {}'.format(tag))
            return True
        print('[DBG] {} silently did nothing'.format(tag))
    return False


