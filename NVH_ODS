def _build_set_card_text(sid, nids):
    if not nids:
        return ''
    lines = ['BEGIN BULK']
    first = ['SET', str(sid), repr(RESPONSE_SET_NAME)]
    first_ids = [str(n) for n in nids[:4]]
    lines.append(','.join(first + first_ids))

    rest = nids[4:]
    while rest:
        chunk = rest[:7]
        lines.append('+,' + ','.join(str(n) for n in chunk))
        rest = rest[7:]

    lines.append('ENDDATA')
    return '\n'.join(lines) + '\n'


def _rebuild_response_set():
    _delete_response_set()

    if not _STATE['response_nids']:
        print('[DBG] no response nodes → SET not created')
        return

    nids = sorted(_STATE['response_nids'])
    used = _collect_used_set_sids()
    sid  = _next_free_set_sid(used)
    print('[DBG] 分配 {} SID = {}（{} 个节点）'
          .format(RESPONSE_SET_NAME, sid, len(nids)))

    text = _build_set_card_text(sid, nids)
    if not text:
        print('[ERR] empty SET text')
        return

    if not _import_bulk_text(text, 'ods_response_set'):
        print('[ERR] 导入 ODS_RESPONSE SET 失败')
        return

    set_ent = _find_set_by_name(RESPONSE_SET_NAME)
    if set_ent is None:
        print('[ERR] 导入后未找到 {} SET'.format(RESPONSE_SET_NAME))
        return

    actual = _get_card_sid(set_ent, 'SID', 'ID')
    try:
        if actual is not None and int(actual) != int(sid):
            print('[WARN] SET SID mismatch: assigned={}, actual={}'
                  .format(sid, actual))
            sid = actual
    except (TypeError, ValueError):
        pass

    _STATE['response_set'] = set_ent
    _STATE['response_sid'] = sid
    print('[DBG] {} SET created: SID={}, {} nodes'
          .format(RESPONSE_SET_NAME, sid, len(nids)))


