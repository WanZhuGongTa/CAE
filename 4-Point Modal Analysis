def _create_loadset(name):
    try:
        ls = base.CreateEntity(
            constants.NASTRAN, 'LOAD_SET', {'Name': name})
        if ls is not None:
            return ls
    except Exception:
        pass
    return None


def _create_darea(nid, c_str, loadset, name):
    fields = {
        'SID': loadset, 'by': 'node', 'P': nid,
        'C': c_str, 'A': 1.0, 'Name': name,
    }
    ent, report = base.CreateEntity(
        constants.NASTRAN, 'DAREA', fields, debug=constants.REPORT_ALL)
    if ent is None:
        print('[ERR] DAREA failed: nid={}, C={!r}'.format(nid, c_str))
    return ent


def on_darea_nodes_4points(w, data):
    try:
        nodes = _pick_grids()
        if not nodes:
            _warn('未选中任何节点。')
            return
        if len(nodes) != 4:
            _warn('必须拾取刚好 4 个节点！当前拾取了 {} 个。'
                  .format(len(nodes)))
            return

        nids = []
        for node in nodes:
            nid = base.GetEntityCardValues(
                constants.NASTRAN, node, ('NID',)).get('NID')
            nids.append(nid)

        _STATE['nodes_4pt'] = nids
        print('[DBG] 拾取的4个节点 (左前, 右前, 左后, 右后): {}'.format(nids))

        for d in _STATE['dareas']:
            try:
                base.DeleteEntity(d['darea_entity'])
            except Exception:
                pass
        _STATE['dareas'] = []

        # 1. 4个点 Z 向 DAREA
        for nid in nids:
            ls_name = 'PT_{}_Z'.format(nid)
            ls = _create_loadset(ls_name)
            if ls:
                darea = _create_darea(nid, '3: Fz', ls, ls_name)
                if darea:
                    _STATE['dareas'].append({
                        'node_id': nid,
                        'loadset_name': ls_name,
                        'loadset_id': getattr(ls, '_id', None),
                        'loadset': ls,
                        'darea_entity': darea,
                        'dir': 'Z',
                    })

        # 2. 前两个点 Y 向 DAREA
        for nid in nids[:2]:
            ls_name = 'PT_{}_Y'.format(nid)
            ls = _create_loadset(ls_name)
            if ls:
                darea = _create_darea(nid, '2: Fy', ls, ls_name)
                if darea:
                    _STATE['dareas'].append({
                        'node_id': nid,
                        'loadset_name': ls_name,
                        'loadset_id': getattr(ls, '_id', None),
                        'loadset': ls,
                        'darea_entity': darea,
                        'dir': 'Y',
                    })

        _info('成功为4个节点建立Z向DAREA，为前2个节点建立Y向DAREA。\n共 {} 个。'
              .format(len(_STATE['dareas'])))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('DAREA 建立失败：{}'.format(e))


