def _create_rload1_for_darea(darea, tabled_ent):
    fields = {
        'Name': darea['loadset_name'],
        'SID': darea['loadset'],
        'EXCITEID': darea['loadset'],
        'TC': tabled_ent,
        'TD': 0,
        'TYPE': '0 Load',
    }
    ent, report = base.CreateEntity(
        constants.NASTRAN, 'RLOAD1', fields, debug=constants.REPORT_ALL)
    if ent is None:
        print('[ERR] RLOAD1 failed for {}'.format(darea['loadset_name']))
    return ent


def _create_dload(sid, name, rload_sids, coeffs):
    lines = ['BEGIN BULK']
    line = 'DLOAD,{},1.0'.format(sid)
    for r_sid, coeff in zip(rload_sids, coeffs):
        line += ',1.0,{},{}'.format(r_sid, coeff)
    lines.append(line)
    lines.append('ENDDATA')
    _import_bulk_text('\n'.join(lines) + '\n', 'dload_{}'.format(name))

    # ★ v9 新增：导入后，根据 SID 找到刚建好的 DLOAD 并重命名
    for ent in _collect('DLOAD'):
        try:
            v = base.GetEntityCardValues(constants.NASTRAN, ent, ('SID',)).get('SID')
            actual_sid = getattr(v, '_id', v)
            if actual_sid == sid:
                _set_entity_name_safe(ent, name)
                print('[DBG] DLOAD {} 已重命名为 {!r}'.format(sid, name))
                break
        except Exception as e:
            print('[DBG] 重命名 DLOAD 失败: {}'.format(e))


def create_rload1_dload(w, data):
    try:
        if not _STATE['dareas']:
            _warn('请先拾取节点并建立 DAREA。')
            return
        if _STATE['tabled_ent'] is None:
            _find_cards_in_model(_get_eigr_type())
        if _STATE['tabled_ent'] is None:
            _warn('缺少 TABLED1，请先 Init Common Cards。')
            return

        _STATE['rload1s'] = []
        for darea in _STATE['dareas']:
            rload = _create_rload1_for_darea(
                darea, _STATE['tabled_ent'])
            if rload:
                _STATE['rload1s'].append({
                    'rload_entity': rload,
                    'loadset_name': darea['loadset_name'],
                    'loadset_id': darea['loadset_id'],
                    'node_id': darea['node_id'],
                    'dir': darea['dir'],
                })

        rload_z = [r['loadset_id'] for r in _STATE['rload1s']
                   if r['dir'] == 'Z']
        rload_y = [r['loadset_id'] for r in _STATE['rload1s']
                   if r['dir'] == 'Y']

        if len(rload_z) != 4 or len(rload_y) != 2:
            _warn('载荷数量不对，请检查 DAREA 拾取步骤。')
            return

        # DLOAD 101: Bending - 4点Z向同相
        _create_dload(101, 'bending', rload_z, [1.0, 1.0, 1.0, 1.0])
        # DLOAD 102: Torsion - 4点Z向反相
        _create_dload(102, 'torsion', rload_z, [-1.0, 1.0, 1.0, -1.0])
        # DLOAD 103: Lateral - 前2点Y向 (+1.0, +1.0)
        _create_dload(103, 'lateral', rload_y, [1.0, 1.0])

        _info('RLOAD1 和 3 个 DLOAD 创建成功！\n'
              'DLOAD 101: bending (4点Z向同相)\n'
              'DLOAD 102: torsion (4点Z向反相)\n'
              'DLOAD 103: lateral (前2点Y向+1.0,+1.0)')
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('RLOAD/DLOAD 失败：{}'.format(e))


# ---------------------------------------------------------------------------
#  [3] 建立 Header
# ---------------------------------------------------------------------------
def create_header(w, data):
    try:
        if not _STATE['rload1s']:
            _warn('请先执行 "2. Create RLOAD & DLOAD"。')
            return
        if (_STATE['freq1_sid'] is None or
                _STATE['eigl_sid'] is None or
                _STATE['tabdmp1_tid'] is None):
            _warn('缺少公共卡片，请先执行 "0. Init Common Cards"。')
            return

        out_kw    = _get_output_keyword()
        eigr_type = _get_eigr_type()

        # ★ 自动识别 NSM
        nsm_sid = _nsm_ensure_nsmadd()

        # ★ 自动识别 MPC / RBE2 / RBE3
        mpc_sids, rbe_count = _mpc_ensure_in_bulk()

        for h in _collect('Nastran Header'):
            try:
                base.DeleteEntity(h)
            except Exception:
                pass
        for s in _collect('SET'):
            nm = _get_entity_name(s)
            if nm and nm.startswith('RESP_'):
                try:
                    base.DeleteEntity(s)
                except Exception:
                    pass

        nids = _STATE['nodes_4pt']
        if not nids:
            _warn('找不到拾取的节点信息。')
            return

        used_sids = _collect_used_sids(
            ['SET', 'NSET', 'ESET', 'BSET'])
        set_sid = _next_free_sid(['SET'])

        set_ent = base.CreateEntity(constants.NASTRAN, 'SET')
        base.SetEntityCardValues(
            constants.NASTRAN, set_ent, {'SID': set_sid})
        # ★ 使用兼容函数代替 base.SetEntityName
        _set_entity_name_safe(set_ent, 'RESP_4PTS')

        grids = []
        for g in _collect('GRID'):
            v = base.GetEntityCardValues(
                constants.NASTRAN, g, ('NID',)).get('NID')
            if v in nids:
                grids.append(g)

        if grids:
            base.AddToSet(set_ent, grids)

        # ===== Header 文本 =====
        lines = [
            'SOL 111',
            'CEND',
            '$=======================================================================',
            'ECHO = NONE',
            'FREQ = {}'.format(_STATE['freq1_sid']),
        ]
        if nsm_sid is not None:
            lines.append('NSM = {}'.format(nsm_sid))
        if mpc_sids:
            lines.append('MPC = {}'.format(mpc_sids[0]))

        lines += [
            '$',
            'METHOD(STRUCTURE) = {}'.format(_STATE['eigl_sid']),
            'SDAMPING(STRUCTURE) = {}'.format(_STATE['tabdmp1_tid']),
            '$',
            'SUBCASE 1',
            'LABEL = bending',
            'DLOAD = 101',
            '{}(SORT2, PUNCH, PHASE) = {}'.format(out_kw, set_sid),
            '$',
            'SUBCASE 2',
            'LABEL = torsion',
            'DLOAD = 102',
            '{}(SORT2, PUNCH, PHASE) = {}'.format(out_kw, set_sid),
            '$',
            'SUBCASE 3',
            'LABEL = lateral',
            'DLOAD = 103',
            '{}(SORT2, PUNCH, PHASE) = {}'.format(out_kw, set_sid),
            '$',
            # ★ 按要求加入以下两个 PARAM
            'PARAM,AMSES,YES',
            'PARAM,CHECKEL,NO',
            'PARAM,POST,-1',
            'PARAM,AUTOSPC,YES',
        ]

        text = '\n'.join(lines)
        print('[DBG] Header:\n{}'.format(text))

        header = base.CreateEntity(constants.NASTRAN, 'Nastran Header')
        if not header:
            _warn('Header 创建失败。')
            return
        base.SetNastranHeaderText(header, text)
        base.SetCurrentEntity(header)

        nsm_msg = 'NSM = {}'.format(nsm_sid) if nsm_sid is not None else '无'
        mpc_msg = 'MPC SID = {}'.format(mpc_sids) if mpc_sids \
            else '无显式MPC'
        if rbe_count > 0:
            mpc_msg += ' (检测到 {} 个 RBE2/RBE3)'.format(rbe_count)

        _info('Header 写入完成！\n'
              'SUBCASE 1: bending  (DLOAD=101)\n'
              'SUBCASE 2: torsion  (DLOAD=102)\n'
              'SUBCASE 3: lateral  (DLOAD=103)\n'
              '响应 SET: RESP_4PTS (SID={})\n'
              'NSM状态: {}\n'
              'MPC状态: {}\n'
              '已添加参数: AMSES=YES, CHECKEL=NO'
              .format(set_sid, nsm_msg, mpc_msg))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('Create Header 失败：{}'.format(e))


# ---------------------------------------------------------------------------
#  [4] Clear All
# ---------------------------------------------------------------------------
def _clear_all_data(w=None, data=None):
    try:
        for d in _STATE['dareas']:
            try:
                base.DeleteEntity(d['darea_entity'])
            except Exception:
                pass
        for r in _STATE['rload1s']:
            try:
                base.DeleteEntity(r['rload_entity'])
            except Exception:
                pass
        for h in _collect('Nastran Header'):
            try:
                base.DeleteEntity(h)
            except Exception:
                pass
        for s in _collect('SET'):
            nm = _get_entity_name(s)
            if nm and nm.startswith('RESP_'):
                try:
                    base.DeleteEntity(s)
                except Exception:
                    pass

        _STATE['dareas'] = []
        _STATE['rload1s'] = []
        _STATE['nodes_4pt'] = []
        _info('已清除所有生成数据。')
    except Exception as e:
        _warn('清除失败：{}'.format(e))
