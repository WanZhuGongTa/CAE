def _warn(msg):
    try:
        guitk.BCMessageWindowCreate(guitk.constants.BCMessageBoxWarning, str(msg), True)
    except Exception:
        print('[WARN] ' + str(msg))


def _info(msg):
    try:
        guitk.BCMessageWindowCreate(guitk.constants.BCMessageBoxInformation, str(msg), True)
    except Exception:
        print('[INFO] ' + str(msg))


def _clear_selection():
    try:
        fn = getattr(base, 'ClearSelection', None)
        if fn:
            fn()
    except Exception:
        pass


def _pick_grids():
    _clear_selection()
    try:
        base.SetPickMethod(base.constants.ENT_SELECTION)
    except Exception:
        pass
    try:
        nodes = base.PickEntities(constants.NASTRAN, 'GRID')
    except Exception as e:
        print('[DBG] PickEntities failed: {}'.format(e))
        return []
    return list(nodes) if nodes else []


def _collect(etype):
    try:
        return base.CollectEntities(constants.NASTRAN, None, etype)
    except Exception:
        return []


def _get_card_sid(ent, *names):
    if ent is None:
        return None
    names = list(names) if names else ['SID', 'TID', 'ID']
    for fn in names:
        try:
            vals = base.GetEntityCardValues(constants.NASTRAN, ent, (fn,))
        except Exception:
            continue
        if not vals:
            continue
        v = vals.get(fn)
        if v is None or v == '':
            continue
        return getattr(v, '_id', v)
    return getattr(ent, '_id', None)


def _get_entity_name(ent):
    if ent is None:
        return None
    try:
        nm = base.GetEntityName(ent)
        if nm:
            return nm
    except Exception:
        pass
    try:
        nm = base.GetEntityCardValues(
            constants.NASTRAN, ent, ('Name',)).get('Name')
        if nm:
            return nm
    except Exception:
        pass
    return None


# ---------------------------------------------------------------------------
#  ★ 安全设置实体名称（多版本兼容，修复 base.SetEntityName 报错）
# ---------------------------------------------------------------------------
def _set_entity_name_safe(ent, name):
    # 方法1：base.SetEntityName（若存在）
    if hasattr(base, 'SetEntityName'):
        try:
            base.SetEntityName(ent, name)
            return True
        except Exception as e:
            print('[DBG] SetEntityName failed: {}'.format(e))

    # 方法2：base.SetEntityCardValues
    for field in ('Name', 'NAME', 'name'):
        try:
            base.SetEntityCardValues(constants.NASTRAN, ent, {field: name})
            try:
                check = base.GetEntityCardValues(
                    constants.NASTRAN, ent, (field,))
                if check and check.get(field) == name:
                    return True
            except Exception:
                pass
        except Exception as e:
            print('[DBG] SetEntityCardValues({}) failed: {}'.format(field, e))

    # 方法3：其他可能的名字接口
    for fn_name in ('SetName', 'SetTitle', 'SetLabel'):
        if hasattr(base, fn_name):
            try:
                getattr(base, fn_name)(ent, name)
                return True
            except Exception as e:
                print('[DBG] {} failed: {}'.format(fn_name, e))

    print('[ERR] 所有命名方式都失败: {}'.format(name))
    return False


def _get_output_keyword():
    kind_w = _STATE.get('out_widget')
    if not kind_w:
        return 'ACCELERATION'
    _, w = kind_w
    try:
        txt = guitk.BCLineEditGetText(w) or ''
    except Exception:
        txt = ''
    low = str(txt).strip().lower()
    if low.startswith('d'):
        return 'DISPLACEMENT'
    if low.startswith('v'):
        return 'VELOCITY'
    return 'ACCELERATION'


def _get_eigr_type():
    kind_w = _STATE.get('eigr_type_widget')
    if not kind_w:
        return 'EIGRL'
    _, w = kind_w
    try:
        txt = guitk.BCLineEditGetText(w) or ''
    except Exception:
        txt = ''
    return 'EIGRA' if str(txt).strip().upper().startswith('EIGRA') else 'EIGRL'


def _import_bulk_text(bulk_text, tag='bulk'):
    if not bulk_text or not bulk_text.strip():
        return True
    tmp = os.path.join(tempfile.gettempdir(), '_{}.nas'.format(tag))
    try:
        with open(tmp, 'w') as f:
            f.write(bulk_text)
        r = base.InputNastran(tmp)
        print('[DBG] import {} -> {}'.format(tag, r))
        return True
    except Exception as e:
        print('[ERR] import {} failed: {}'.format(tag, e))
        return False
    finally:
        try:
            os.remove(tmp)
        except Exception:
            pass


# ---------------------------------------------------------------------------
#  ★ NSM 自动识别逻辑（完全参考 NVH_IPI.py 原版）
# ---------------------------------------------------------------------------
def _nsm_get_sid_from_card(ent, field='SID'):
    if ent is None:
        return None
    try:
        vals = base.GetEntityCardValues(constants.NASTRAN, ent, (field,))
    except Exception:
        return None
    v = vals.get(field)
    if v is None or v == '':
        return None
    v = getattr(v, '_id', v)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _nsm_ensure_nsmadd():
    """返回 CEND 中 NSM 关键字使用的 SID（或 None）。NSMADD 通过 BULK 导入。
    ★ NSMADD 是独立实体，不会被 create_header 删除 Header 时误删。
    ★ 复用已有 NSMADD 时，与参考代码 NVH_IPI.py 完全一致：取 max。"""
    nsm_sids = []
    for ent in _collect('NSM'):
        sid = _nsm_get_sid_from_card(ent, 'SID')
        if sid is not None and sid not in nsm_sids:
            nsm_sids.append(sid)

    nsmadd_sids = []
    for ent in _collect('NSMADD'):
        sid = _nsm_get_sid_from_card(ent, 'SID')
        if sid is not None:
            nsmadd_sids.append(sid)

    # ★ 与参考代码完全一致：复用已有 NSMADD 时取 max
    if nsmadd_sids:
        print('[DBG] 复用已有 NSMADD SID 列表: {}，取 max = {}'
              .format(nsmadd_sids, max(nsmadd_sids)))
        return max(nsmadd_sids)

    if not nsm_sids:
        print('[DBG] 未检测到 NSM 卡片，跳过 NSM 处理。')
        return None

    used = set(nsm_sids) | set(nsmadd_sids)
    new_sid = 1
    while new_sid in used:
        new_sid += 1

    fields = [str(new_sid)] + [str(s) for s in nsm_sids]
    lines = ['BEGIN BULK']
    first = fields[:8]
    lines.append('NSMADD,' + ','.join(first))
    rest = fields[8:]
    while rest:
        chunk = rest[:8]
        lines.append('+,' + ','.join(chunk))
        rest = rest[8:]
    lines.append('ENDDATA')

    if _import_bulk_text('\n'.join(lines) + '\n', 'nsmadd'):
        print('[DBG] 成功生成 NSMADD，SID = {}，包含 NSM: {}'
              .format(new_sid, nsm_sids))
        return new_sid
    return None


# ---------------------------------------------------------------------------
#  ★ MPC 自动识别逻辑
# ---------------------------------------------------------------------------
def _mpc_ensure_in_bulk():
    mpc_sids = []
    rbe_count = 0
    for etype in ('MPC', 'RBE2', 'RBE3'):
        try:
            ents = _collect(etype)
            for ent in ents:
                sid = _get_card_sid(ent, 'SID')
                if etype == 'MPC':
                    if sid is not None and sid not in mpc_sids:
                        mpc_sids.append(sid)
                else:
                    rbe_count += 1
        except Exception as e:
            print('[DBG] 扫描 {} 失败: {}'.format(etype, e))
    print('[DBG] MPC 自动识别: 显式MPC={}, RBE2/3数量={}'
          .format(mpc_sids, rbe_count))
    return mpc_sids, rbe_count


# ---------------------------------------------------------------------------
#  [0] Init Common Cards
# ---------------------------------------------------------------------------
def _pad8(s):
    return '{:<8}'.format(str(s))[:8]


def _collect_used_sids(etype_list):
    used = set()
    for etype in etype_list:
        for ent in _collect(etype):
            sid = _get_card_sid(ent)
            if sid is None:
                continue
            try:
                used.add(int(sid))
            except (TypeError, ValueError):
                pass
    return used


def _next_free_sid(etype_list):
    used = _collect_used_sids(etype_list)
    n = 1
    while n in used:
        n += 1
    return n


def _allocate_common_sids(eigr_type='EIGRL'):
    tabled_sid = _next_free_sid(['TABLED1'])
    tabdmp_sid = _next_free_sid(['TABDMP1', 'TABDMP', 'TABDMP0'])
    freq_sid   = _next_free_sid(['FREQ1', 'FREQ'])
    eigl_sid   = _next_free_sid(['EIGRA'] if eigr_type == 'EIGRA'
                                else ['EIGRL', 'EIGR'])
    return tabled_sid, tabdmp_sid, freq_sid, eigl_sid


def _build_common_cards_nas(tabled_sid, tabdmp_sid, freq_sid, eigl_sid,
                            f1, df, ndf, damp, v2, tx1, ty1, tx2, ty2,
                            eigr_type='EIGRL'):
    lines = ['BEGIN BULK']
    lines.append(_pad8('TABLED1') + _pad8(str(tabled_sid)) +
                 _pad8('LINEAR') + _pad8('LINEAR'))
    lines.append('+' + ' ' * 7 +
                 _pad8(tx1) + _pad8(ty1) + _pad8(tx2) + _pad8(ty2))
    lines.append('+' + ' ' * 7 + _pad8('ENDT'))

    lines.append(_pad8('TABDMP1') + _pad8(str(tabdmp_sid)) + _pad8('G'))
    lines.append('+' + ' ' * 7 +
                 _pad8(tx1) + _pad8(damp) + _pad8(tx2) + _pad8(damp))
    lines.append('+' + ' ' * 7 + _pad8('ENDT'))

    lines.append('FREQ1,{},{},{},{}'.format(freq_sid, f1, df, ndf))

    if eigr_type == 'EIGRA':
        lines.append('EIGRA,{},0.0,{}'.format(eigl_sid, v2))
    else:
        lines.append('EIGRL,{},0.0,{}'.format(eigl_sid, v2))

    lines.append('ENDDATA')
    return '\n'.join(lines) + '\n'


def _find_cards_in_model(eigr_type='EIGRL'):
    tabs = _collect('TABLED1') or _collect('TABLED')
    if tabs:
        _STATE['tabled_ent'] = tabs[0]

    for name in ('TABDMP1', 'TABDMP', 'TABDMP0'):
        ents = _collect(name)
        if ents:
            _STATE['tabdmp1_tid'] = _get_card_sid(
                ents[0], 'TID', 'SID', 'ID')
            break

    for name in ('FREQ1', 'FREQ'):
        ents = _collect(name)
        if ents:
            _STATE['freq1_sid'] = _get_card_sid(
                ents[0], 'SID', 'TID', 'ID')
            break

    search = ['EIGRA', 'EIGRL', 'EIGR'] if eigr_type == 'EIGRA' \
        else ['EIGRL', 'EIGR', 'EIGRA']
    for name in search:
        ents = _collect(name)
        if ents:
            _STATE['eigl_sid'] = _get_card_sid(
                ents[0], 'SID', 'TID', 'ID')
            break


def init_common_cards(w, data):
    try:
        freq_edit, damp_edit, eigr_type_edit, eigl_edit, tab_edit = data

        parts = [p.strip()
                 for p in guitk.BCLineEditGetText(freq_edit).split(',')]
        if len(parts) != 3:
            _warn('FREQ1 格式应为 "F1, DF, NDF"')
            return
        f1, df, ndf = float(parts[0]), float(parts[1]), int(float(parts[2]))

        damp = guitk.BCLineEditGetDouble(damp_edit)
        if damp <= 0:
            _warn('阻尼比必须大于 0')
            return

        eigr_type = _get_eigr_type()

        v2 = guitk.BCLineEditGetDouble(eigl_edit)
        if v2 <= 0:
            _warn('上限频率必须大于 0')
            return

        parts_t = [p.strip()
                   for p in guitk.BCLineEditGetText(tab_edit).split(',')]
        if len(parts_t) != 4:
            _warn('TABLED1 格式应为 "x1, y1, x2, y2"')
            return
        tx1, ty1, tx2, ty2 = [float(p) for p in parts_t]

        for etype in ('TABLED1', 'TABLED', 'TABDMP', 'TABDMP1',
                      'FREQ', 'FREQ1', 'EIGRL', 'EIGR', 'EIGRA'):
            for ent in _collect(etype):
                try:
                    base.DeleteEntity(ent)
                except Exception:
                    pass

        tabled_sid, tabdmp_sid, freq_sid, eigl_sid = \
            _allocate_common_sids(eigr_type)
        _STATE['freq1_sid']   = freq_sid
        _STATE['tabdmp1_tid'] = tabdmp_sid
        _STATE['eigl_sid']    = eigl_sid

        nas_text = _build_common_cards_nas(
            tabled_sid, tabdmp_sid, freq_sid, eigl_sid,
            f1, df, ndf, damp, v2, tx1, ty1, tx2, ty2, eigr_type)
        _import_bulk_text(nas_text, 'init_cards')
        _find_cards_in_model(eigr_type)

        _info('公共卡片初始化成功。\n模态方法 = {}\nSID = {}'
              .format(eigr_type, eigl_sid))
    except Exception as e:
        import traceback
        print(traceback.format_exc())
        _warn('初始化失败：{}'.format(e))


